#!/bin/bash
# sshd host-side launcher.
#
# Builds the image if missing, then runs a hardened SSH server container:
# key-only login, native brute-force banning, persistent host key. The
# container's port 22 is published on a chosen (--port) or random host port.
set -euo pipefail

info()  { echo -e "\033[1;32m${*}\033[0m" >&2; }
warn()  { echo -e "\033[1;33m${*}\033[0m" >&2; }
error() { echo -e "\033[1;31m${*}\033[0m" >&2; exit 1; }

script_dir="$(cd "$(dirname "$0")" && pwd)"
image="sshd-box"
container="sshd-box"
keys_volume="sshd-box-keys"

ssh_user="dev"
pubkey_file=""
pubkey_url=""
pubkey_inline="${SSH_AUTHORIZED_KEYS:-}"
port=""
bind_ip="0.0.0.0"
sudo_flag="false"
host_net=""
force_build=""

# Pick a probably-free high port (best-effort check where `ss` exists).
random_free_port() {
    local p
    for _ in 1 2 3 4 5; do
        p=$(( (RANDOM % 40000) + 20000 ))
        if command -v ss >/dev/null 2>&1; then
            ss -ltn 2>/dev/null | grep -q ":$p " || { echo "$p"; return; }
        else
            echo "$p"; return
        fi
    done
    echo "$p"
}

usage() {
    cat <<EOF
Usage: $0 [options]

Key source (at least one required):
  --pubkey <file>       authorized_keys file to install
  --pubkey-url <url>    fetch authorized_keys from a URL
  --key '<ssh-...>'     an inline public key (repeatable via SSH_AUTHORIZED_KEYS)

Options:
  --user <name>         login user (default: $ssh_user)
  --port <port>         SSH port (default: random). In --host-net mode this is
                        the real host port sshd binds (must not be 22).
  --bind <ip>           host bind address, bridge mode only (default: $bind_ip)
  --host-net            use host networking (preserves real client IPs so the
                        per-source banning works; sshd binds --port directly)
  --sudo                grant the login user passwordless sudo
  --name <name>         container name (default: $container)
  --keys-volume <v>     host-key volume (default: $keys_volume)
  --build, --rebuild    force image rebuild
  --help                Show this help

Examples:
  $0 --pubkey ~/.ssh/id_ed25519.pub --port 2222
  $0 --pubkey-url https://github.com/you.keys        # random port
  $0 --key 'ssh-ed25519 AAAA... you@host' --user ops --sudo
  $0 --pubkey ~/.ssh/id_ed25519.pub --port 2222 --host-net   # real client IPs
EOF
    exit 1
}

while [ $# -gt 0 ]; do
    case "$1" in
        --pubkey)          shift; pubkey_file=$1; shift ;;
        --pubkey-url)      shift; pubkey_url=$1; shift ;;
        --key)             shift; pubkey_inline="${pubkey_inline:+$pubkey_inline\n}$1"; shift ;;
        --user)            shift; ssh_user=$1; shift ;;
        --port)            shift; port=$1; shift ;;
        --bind)            shift; bind_ip=$1; shift ;;
        --sudo)            sudo_flag="true"; shift ;;
        --host-net)        host_net="1"; shift ;;
        --name)            shift; container=$1; shift ;;
        --keys-volume)     shift; keys_volume=$1; shift ;;
        --build|--rebuild) force_build="1"; shift ;;
        --help|-h)         usage ;;
        *)                 warn "unknown option: $1"; shift ;;
    esac
done

# Validate key source.
[ -n "$pubkey_file" ] && [ ! -f "$pubkey_file" ] && error "pubkey file not found: $pubkey_file"
if [ -z "$pubkey_file" ] && [ -z "$pubkey_url" ] && [ -z "$pubkey_inline" ]; then
    error "provide a key: --pubkey <file>, --pubkey-url <url>, or --key '<ssh-...>'"
fi

cd "$script_dir"
if [ -n "$force_build" ] || ! docker image inspect "$image" >/dev/null 2>&1; then
    info "Building $image image..."
    docker build -t "$image" .
fi

if docker ps -a --format '{{.Names}}' | grep -qx "$container"; then
    info "Removing existing container: $container"
    docker rm -f "$container" >/dev/null
fi

run_args=(
    -d
    --name "$container"
    --restart unless-stopped
    -v "${keys_volume}:/etc/ssh/keys"
    -e "SSH_USER=${ssh_user}"
    -e "SSH_SUDO=${sudo_flag}"
)

# Networking: host mode (real client IPs, sshd binds --port directly) vs the
# default bridge mode (container listens on 22, host maps a chosen/random port).
host_port=""
if [ -n "$host_net" ]; then
    [ -z "$port" ] && port="$(random_free_port)"
    [ "$port" = "22" ] && warn "port 22 in --host-net mode will clash with the host's own sshd"
    run_args+=(--network host -e "SSH_PORT=${port}")
    host_port="$port"
else
    run_args+=(--hostname "$container")
    if [ -n "$port" ]; then
        run_args+=(-p "${bind_ip}:${port}:22")
    else
        run_args+=(-p "${bind_ip}::22")
    fi
fi

[ -n "$pubkey_inline" ] && run_args+=(-e "SSH_AUTHORIZED_KEYS=${pubkey_inline}")
[ -n "$pubkey_url" ]    && run_args+=(-e "SSH_AUTHORIZED_KEYS_URL=${pubkey_url}")
[ -n "$pubkey_file" ]   && run_args+=(-v "$(cd "$(dirname "$pubkey_file")" && pwd)/$(basename "$pubkey_file"):/config/authorized_keys:ro")

info "Starting $container..."
docker run "${run_args[@]}" "$image" >/dev/null

# In bridge mode, discover the Docker-assigned port.
if [ -z "$host_net" ]; then
    mapped="$(docker port "$container" 22/tcp 2>/dev/null | head -n1)"
    host_port="${mapped##*:}"
fi
info "Started. SSH server listening on port ${host_port:-?}${host_net:+ (host networking)}"
info "  ssh -p ${host_port:-<port>} ${ssh_user}@<host>"
info "Follow logs (host-key fingerprint prints here):  docker logs -f $container"
