# sshd container environment file. Copy to .sshd.env and edit.
#
#   cp .sshd.env.example .sshd.env
#   ./run --env-file .sshd.env          # (or pass flags directly)
#
# NOTE: docker --env-file does NOT support inline comments — keep comments on
# their own line; everything after `=` is literal.

# ===== Login user =====
# Non-root user to log in as. Created on first start.
#SSH_USER=dev

# Grant that user passwordless sudo. Values: true | false
#SSH_SUDO=false

# ===== Authorized keys (at least one source required) =====
# Inline public key(s). Multiple keys: separate with a literal \n.
#SSH_AUTHORIZED_KEYS=ssh-ed25519 AAAA... you@host

# Fetch authorized_keys from a URL (e.g. your GitHub keys).
#SSH_AUTHORIZED_KEYS_URL=https://github.com/you.keys

# (A mounted file at /config/authorized_keys is also picked up automatically.)

# ===== Brute-force banning (native OpenSSH PerSourcePenalties) =====
# Max auth attempts per connection before it is dropped.
#SSH_MAX_AUTH_TRIES=3

# Seconds a client has to authenticate before disconnect.
#SSH_LOGIN_GRACE=20

# Penalty added per auth failure, and the ceiling. A source that keeps failing
# is refused for escalating durations up to the max.
#SSH_PENALTY_AUTHFAIL=20s
#SSH_PENALTY_MAX=30m

# ===== Misc =====
# Allow TCP forwarding (turn a login into a jump/tunnel host). Values: yes | no
#SSH_ALLOW_TCP_FORWARDING=no
