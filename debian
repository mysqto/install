readonly RED='\033[1;31m'
readonly GREEN='\033[1;32m'
readonly YELLOW='\033[1;33m'
readonly NC='\033[0m' # No Color

function installed() {
    type "$1" >/dev/null 2>&1
}

function warn() {
    printf "${YELLOW}%s${NC}\n" "$*"
}

function error() {
    printf "${RED}%s${NC}\n" "$*" >&2
    exit 1
}

function info() {
    printf "${GREEN}%s${NC}\n" "$*"
}

function generate_password() {
    local length="${1:-32}" # Default length is 32 if not specified
    local password=""
    local -a methods=(
        "pwgen -nsy $length 1"
        "mkpasswd -l $length -C $((length / 2)) -s $((length / 8))"
        "openssl rand -base64 $length"
        "busybox mkpasswd -l $length -C $((length / 2)) -s $((length / 8))"
        "tr -dc 'a-zA-Z0-9' </dev/urandom | head -c $length"
    )

    for method in "${methods[@]}"; do
        password=$($method 2>/dev/null)
        if [ -n "$password" ]; then
            echo "$password"
            return 0
        fi
    done
    error "Failed to generate password using any available method"
}

function make_password_hash() {
    local password="$1"
    local salt="$2"
    mkpasswd -m sha-512 -S "$salt" "$password" 2>/dev/null \
        || openssl passwd -6 "$password" 2>/dev/null \
        || busybox mkpasswd -m sha-512 -S "$salt" "$password" 2>/dev/null || {
        for python in python3 python python2; do
            installed "$python" || continue
            "$python" -c 'import crypt, sys; print(crypt.crypt(sys.argv[1], crypt.mksalt(crypt.METHOD_SHA256)))' "$password" 2>/dev/null && break
        done
    }
}

function get_timezone() {
    local timezone=""
    local -a methods=(
        "curl --connect-timeout 30 -sL http://ip-api.com/json | jq -r '.timezone'"
        "curl --connect-timeout 30 -sL https://ipinfo.io | jq -r '.timezone'"
        "curl --connect-timeout 30 -sL https://ifconfig.co/json | jq -r '.time_zone'"
        "cat /etc/timezone"
        "realpath /etc/localtime | sed 's/\/usr\/share\/zoneinfo\//'"
        "timedatectl | awk '/Time zone:/ {print \$3}'"
    )

    for method in "${methods[@]}"; do
        timezone=$(eval "$method" 2>/dev/null)
        if [ -n "$timezone" ] && [ "$timezone" != "null" ]; then
            echo "$timezone"
            return 0
        fi
    done

    echo "UTC"
}

function get_hostname() {
    local host
    # Try each method in sequence until one succeeds
    host=$(hostname 2>/dev/null) \
        || host=$(cat /etc/hostname 2>/dev/null) \
        || host=$(cat /proc/sys/kernel/hostname 2>/dev/null) \
        || host=$(LC_ALL=C tr </dev/urandom -dc 'a-zA-Z0-9' | head -c 8)
    echo "$host"
}

function download() {
    local url="${1:?'URL parameter is required'}"
    local target="${2:-"$(basename "$url")"}"
    local target_dir
    local temp_file

    # Validate URL format
    if [[ ! "$url" =~ ^https?:// ]]; then
        error "Invalid URL format: $url"
    fi

    # Create target directory if needed
    target_dir="$(dirname "$target")"
    mkdir -p "$target_dir" || error "Failed to create directory: $target_dir"

    # Use temporary file for atomic downloads
    temp_file="$(mktemp "${target}.XXXXXX")"

    # Cleanup on exit
    trap 'rm -f "$temp_file"' EXIT

    info "Downloading $url to $target"
    if curl ${CURL_OPTS} --fail \
        --silent \
        --show-error \
        --location \
        --retry 3 \
        --retry-delay 2 \
        --connect-timeout 10 \
        --progress-bar \
        -o "$temp_file" \
        "$url"; then
        # Atomic move of completed download
        mv "$temp_file" "$target" || error "Failed to save download to: $target"
        trap - EXIT
    else
        error "Failed to download: $url (curl exit code: $?)"
    fi
}

function ipv6_prefix_length_to_subnet_mask() {
    local prefix_length=$1
    local subnet_mask=""

    # Ensure that prefix length is valid
    if [ "$prefix_length" -lt 0 ] || [ "$prefix_length" -gt 128 ]; then
        error "Invalid IPv6 prefix length."
    fi

    # Calculate subnet mask in hexadecimal format
    for ((i = 0; i < 32; i++)); do
        if [ "$i" -lt "$((prefix_length / 4))" ]; then
            subnet_mask+="f"
        else
            subnet_mask+="0"
        fi
        if [ "$((i % 4))" -eq 3 ] && [ "$i" -ne 31 ]; then
            subnet_mask+=":"
        fi
    done
    echo "$subnet_mask"
}

function cidr_to_netmask() {
    set -- $((5 - ($1 / 8))) 255 255 255 255 $(((255 << (8 - ($1 % 8))) & 255)) 0 0 0
    # shellcheck disable=SC2015
    [ "$1" -gt 1 ] && shift "$1" || shift
    echo "${1-0}"."${2-0}"."${3-0}"."${4-0}"
}

# Improved ip_address function using parameter expansion and case
function ip_address() {
    local if="${1:-$(default_interface)}"
    local type="${2:-4}"

    case "$type" in
        4) ip -"$type" -o addr show "$if" | head -1 | awk '{split($4,a,"/"); print a[1]}' ;;
        6) ip -"$type" -o addr show "$if" | head -1 | awk '{print $4}' ;;
        *) error "Invalid IP type: $type" ;;
    esac
}

# Improved netmask function using parameter expansion and functions
function netmask() {
    local if="${1:-$(default_interface)}"
    local type="${2:-4}"
    local mask=""

    case "$type" in
        6)
            local prefix_length
            prefix_length=$(ip -"$type" -o addr show "$if" | awk '{split($4,a,"/"); print a[2]}' | head -1)
            mask=$(ipv6_prefix_length_to_subnet_mask "$prefix_length")
            ;;
        4)
            mask=$(cidr_to_netmask "$(ip -"$type" -o addr show "$if" | head -1 | awk '{split($4,a,"/"); print a[2]}')")
            # Handle Google Cloud Platform special case
            if [ "$mask" == "255.255.255.255" ]; then
                local asn
                asn=$(curl ${CURL_OPTS} --connect-timeout 30 -s -"$type" "https://ipconfig.io/json" | jq -r '.asn_org' 2>/dev/null)
                if [ "$asn" == "GOOGLE-CLOUD-PLATFORM" ]; then
                    mask="255.255.255.0"
                    mirror_protocol="http"
                fi
            fi
            ;;
        *)
            error "Invalid IP type: $type"
            ;;
    esac

    [ -z "$mask" ] && error "failed to get netmask"
    echo "$mask"
}

# shellcheck disable=SC2120
function default_gateway() {
    local type="${1:-4}"
    local gw

    # Validate IP version
    case "$type" in
        4 | 6) ;;
        *) error "Invalid IP version: $type. Must be 4 or 6" ;;
    esac

    # Check if ip command exists
    if ! type ip >/dev/null 2>&1; then
        error "ip command not found. Please install iproute2 package."
    fi

    # Get default gateway more efficiently
    gw=$(ip -"$type" route show default 2>/dev/null \
        | awk '/^default/ {print $3; exit}')

    # Validate gateway was found
    if [ -z "$gw" ]; then
        warn "No IPv$type default gateway found"
        return 1
    fi

    echo "$gw"
}

# shellcheck disable=SC2120
function default_interface() {
    type="$1"
    [ -z "$type" ] && type="4"
    result="$(ip -"$type" route show default | awk '{print $5}' | head -n1)"

    # if there is no default interface, maybe bc it's ipv6 only, try to get the interface with ipv6 address
    if [ -z "$result" ] && [ "$type" == "4" ]; then
        result="$(ip -"$type" route show default | awk '{print $5}' | head -n1)"
    fi
    echo "$result"
}

# get current dns server
function dns() {
    resolvectl dns -i "$(default_interface)" 2>/dev/null | awk '{print $4}'
}

function ipv6_enabled() {
    public_ipv6="$(curl ${CURL_OPTS} --connect-timeout 5 -m 10 -6 -sL https://ifconfig.co 2>/dev/null)" \
        || public_ipv6="$(curl ${CURL_OPTS} --connect-timeout 5 -m 10 -6 -sL https://ipconfig.io 2>/dev/null)"
    [ -z "$public_ipv6" ] && return 1
    return 0
}

function get_disk() {
    # lsblk -oMOUNTPOINT,PKNAME -P | grep 'MOUNTPOINT="/"' | cut -d'"' -f4 | sed 's/[n][0-9]//g'
    lsblk -oMOUNTPOINT,PKNAME -rn | awk '$1 ~ /^\/$/ { print $2 }'
}

function get_all_disks() {
    # list all disks (type "disk"), exclude loop/rom devices, normalize to /dev/ paths
    lsblk -dnro NAME,TYPE | awk '$2 == "disk" { print "/dev/" $1 }'
}

function normalize_disk() {
    local d="$1"
    [[ "$d" =~ ^/dev/ ]] || d="/dev/$d"
    echo "$d"
}

function has_kernel() {
    local suite="$1"
    local arch="$2"
    local mirror="$3"
    packages_url="$mirror/dists/$suite/main/binary-$arch/Packages.xz"
    kernels="$(curl ${CURL_OPTS} -sL --connect-timeout 30 "$packages_url" | xzgrep -c 'Package: linux-image-'"$arch"'$' 2>/dev/null)"
    if [ "$kernels" -gt 0 ]; then
        return 0
    fi

    warn "No kernel is available for $arch/$suite"
    return 1
}

function has_cloud_kernel() {
    local suite="$1"
    local arch="$2"
    local mirror="$3"
    packages_url="$mirror/dists/$suite/main/binary-$arch/Packages.xz"
    kernels="$(curl ${CURL_OPTS} -sL --connect-timeout 30 "$packages_url" | xzgrep -c 'Package: linux-image-cloud-'"$arch"'$' 2>/dev/null)"
    if [ "$kernels" -gt 0 ]; then
        return 0
    fi

    warn "No cloud kernel is available for $arch/$suite"
    return 1
}

function has_backports() {
    local suite="$1-backports"
    local arch="$2"
    local mirror="$3"
    local debian_packages=""
    packages_url="$mirror/dists/$suite/main/binary-$arch/Packages.xz"
    debian_packages="$(curl ${CURL_OPTS} -sL --connect-timeout 30 "$packages_url" | xzgrep -c "Package: .*" 2>/dev/null)"
    if [ "$debian_packages" -gt 0 ]; then
        return 0
    fi

    warn "backports repository is not available for $arch/$suite"
    return 1
}

