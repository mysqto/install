# Helper function to add conditional flags
add_flag() {
    local var="$1"
    local flag="${2:-${var//_/-}}" # Use provided flag or convert var name
    [ "${!var}" = true ] && cmd+=("--$flag")
}

# Helper function to add conditional parameters
# Usage: add_param var_name [param_name] [base64]
add_param() {
    local var="$1"
    local param="${2:-${var//_/-}}" # Use provided param or convert var name
    local encode_base64="$3"
    [ -z "${!var}" ] && return
    local value="${!var}"
    if [ "$encode_base64" = "base64" ]; then
        value=$(printf '%s' "$value" | base64 | tr -d '\n')
    fi
    cmd+=("--$param \"$value\"")
}

function build_provision_params() {
    local cmd=()

    # Network options
    ipv6_enabled && cmd+=("--ipv6-dhcp")
    add_flag "disable_ipv6"
    add_flag "use_ethx" "ethx"

    # User and SSH options
    add_param "username"
    add_param "ssh_port" "ssh"
    add_param "authorized_keys" "authorized-keys-base64" "base64"
    add_flag "sudo_without_password"

    # System tools installation flags
    local tools=(
        "socat" "go" "im" "neofetch" "fish"
        "docker" "quemu_guest_agent:qemu-guest-agent"
    )
    for tool in "${tools[@]}"; do
        local name="${tool%%:*}"
        local flag="${tool#*:}"
        [ "$flag" = "$name" ] && flag="${name//_/-}"
        add_flag "install_$name" "$flag"
    done

    # Additional system flags
    add_flag "bbr"
    add_flag "byobu"

    # Shadowsocks configuration
    if [ "$install_shadowsocks" = true ]; then
        cmd+=("--shadowsocks")
        add_param "shadowsocks_port" "shadowsocks-port"
        add_param "shadowsocks_password" "shadowsocks-password"
        add_param "shadowsocks_obfs_host" "shadowsocks-obfs-host"
    fi

    # Shadow-TLS and Snell configuration
    if [ "$install_shadow_tls" = true ]; then
        cmd+=("--shadow-tls")
        add_param "shadow_tls_password" "shadow-tls-password"
        add_param "shadow_tls_port" "shadow-tls-port"
        add_param "shadow_tls_obfs_host" "shadow-tls-obfs-host"
        add_param "snell_port" "snell-port"
        add_param "snell_psk" "snell-psk"
        add_param "snell_obfs" "snell-obfs"
        add_param "snell_version" "snell-version"
    fi

    # Join all parts with spaces
    printf '%s' "${cmd[*]}"
}

function build_provision_command() {
    local timestamp
    timestamp=$(date '+%Y%m%d%H%M%S')
    local provision_file="/tmp/provision_${timestamp}.sh"
    local provision_log="/var/log/provision_${timestamp}.log"
    local late_command

    # Base command
    late_command="curl -sL --connect-timeout 30 $base/provision -o $provision_file; chmod +x $provision_file; $provision_file $(build_provision_params)"

    # Add logging and optional cleanup
    if [ "$debug_provision" = true ]; then
        printf '%s >>%s 2>&1' "$late_command" "$provision_log"
    else
        printf '%s >>%s 2>&1; rm -rf "%s" "%s"' \
            "$late_command" "$provision_log" "$provision_file" "$provision_log"
    fi
}

