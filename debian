    # check and enable community repository
    if ! grep -q "^http://dl-cdn.alpinelinux.org/alpine/$alpine_version/community" "$apk_repositories"; then
        echo "@community http://dl-cdn.alpinelinux.org/alpine/$alpine_version/community" >>"$apk_repositories"
    fi
    # check and enable testing repository
    if ! grep -q "^http://dl-cdn.alpinelinux.org/alpine/$alpine_version/testing" "$apk_repositories"; then
        echo "@testing http://dl-cdn.alpinelinux.org/alpine/$alpine_version/testing" >>"$apk_repositories"
    fi

    apk update

    dependencies=(
        pwgen
        curl
        cpio@community
        openssh-client
        jq
        xz
    )

    to_install=()

    for dependency in "${dependencies[@]}"; do
        if ! apk info -vv | grep -q "^$dependency" 2>/dev/null; then
            to_install+=("$dependency")
        fi
    done

    apk add --no-cache "${to_install[@]}"
