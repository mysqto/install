    boot_size="$boot_size_num"
    case "$size_unit" in
        K | k)
            boot_size=$((boot_size / 1024)) # convert to MB
            ;;
        M | m)
            boot_size=$((boot_size)) # already in MB
            ;;
        G | g)
            boot_size=$((boot_size * 1024)) # convert to MB
            ;;
        *)
            warn "unknown unit $size_unit for boot size, use 512MB as default"
            boot_size=512
            ;;
    esac
    # if boot size is smaller than 512, set it to 512
    [ "$boot_size" -lt 512 ] && {
        warn "boot size is smaller than 512MB, set it to 512MB"
        boot_size=512
