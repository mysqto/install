# tailscale container environment file. Copy to .tailscale.env and edit.
#
#   cp .tailscale.env.example .tailscale.env
#   ./run --env-file .tailscale.env          # or:  im -ts --env-file .tailscale.env
#
# IMPORTANT: this file is consumed by `docker --env-file`, which does NOT support
# inline comments. Everything after `=` is taken literally, so a line like
#   SS_MODE=tcp_and_udp   # my note
# sets SS_MODE to "tcp_and_udp   # my note" and breaks the config. Keep comments
# on their OWN line (a line starting with #) and put nothing after the value.
#
# Nothing here is baked into the image — the auth key stays on the host.

# ===== Tailnet =====

# REQUIRED on first login. Generate at:
#   https://login.tailscale.com/admin/settings/keys
# Ephemeral + reusable is convenient for a disposable node. After the first
# successful login the node state is persisted in the tailscale-ss-state volume
# and the key is no longer needed.
TS_AUTHKEY=

# Node name shown in the tailnet (default: container hostname).
#TS_HOSTNAME=ss-gateway

# Pull in subnet routes advertised by OTHER tailnet nodes. Default true.
#TS_ACCEPT_ROUTES=true

# Let tailscaled manage the container's DNS (MagicDNS). Off by default because
# it rewrites /etc/resolv.conf, which is fragile in containers.
# Values: true | false
#TS_ACCEPT_DNS=false

# Advertise LOCAL subnets from this node (comma-separated). Makes the container
# a subnet router — needs approval in the admin console. Enables ip_forward.
#TS_ROUTES=192.168.1.0/24,10.0.0.0/24

# Offer this node as an exit node (needs admin approval).
# Values: true | false
#TS_ADVERTISE_EXIT_NODE=false

# Route this node's own egress through another tailnet exit node.
#TS_EXIT_NODE=100.101.102.103

# Extra flags appended verbatim to `tailscale up`.
#TS_EXTRA_ARGS=--shields-up

# ===== Shadowsocks (external entry point) =====

# Port clients connect to.
#SS_PORT=8388

# Password. Auto-generated and printed in the logs if left blank.
#SS_PASSWORD=

# AEAD cipher.
#SS_METHOD=chacha20-ietf-poly1305

# Transport. Values: tcp_only | udp_only | tcp_and_udp
#SS_MODE=tcp_and_udp

# simple-obfs plugin (same wire format as blackhole / shadowsocks-libev).
# Values: http | tls | none
#SS_OBFS=http

# Host clients masquerade as (client-side hint; the server ignores it).
#SS_OBFS_HOST=microsoft.com
