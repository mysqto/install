#!/usr/bin/env bash

# FRP installer
# Modes:
#   default: install frps on this machine
#   --client user@host: install frpc on this machine, fetching server bindPort/token via SSH

function warn()  { echo -e "\033[1;33m${*}\033[0m"; }
function error() { echo -e "\033[1;31m${*}\033[0m"; exit 1; }
function info()  { echo -e "\033[1;32m${*}\033[0m"; }
function installed() { command -v "$1" >/dev/null 2>&1; }

CURL_OPTS="${CURL_OPTS:-}"

function detect_os() {
    case "$(uname -s)" in
        Linux)  echo "linux" ;;
        Darwin) echo "darwin" ;;
        *) error "Unsupported OS: $(uname -s)" ;;
    esac
}

function detect_arch() {
    case "$(uname -m)" in
        x86_64 | amd64)   echo "amd64" ;;
        aarch64 | arm64)  echo "arm64" ;;
        i386 | i686)      echo "386" ;;
        armv7* | armv6*)  echo "arm" ;;
        *) error "Unsupported architecture: $(uname -m)" ;;
    esac
}

function install_pkg() {
    if installed apt-get; then
        apt-get update >/dev/null 2>&1
        DEBIAN_FRONTEND=noninteractive apt-get install -y "$@"
    elif installed dnf; then
        dnf install -y "$@"
    elif installed yum; then
        yum install -y "$@"
    elif installed zypper; then
        zypper install -y "$@"
    elif installed pacman; then
        pacman -Sy --noconfirm "$@"
    elif installed apk; then
        apk add --no-cache "$@"
    else
        error "No supported package manager found to install: $*"
    fi
}

function ensure_curl() {
    installed curl && return 0
    warn "curl not found, installing..."
    install_pkg curl
    installed curl || error "curl install failed"
}

function ensure_sshpass() {
    installed sshpass && return 0
    if [ "$(uname -s)" = "Darwin" ]; then
        error "--ssh-pass is not supported on macOS; use --ssh-key (or your ~/.ssh/config)"
    fi
    warn "sshpass not found, installing for password auth..."
    install_pkg sshpass
    installed sshpass || error "sshpass install failed"
}

function gen_token() {
    pwgen -ns 32 1 2>/dev/null \
        || openssl rand -hex 16 2>/dev/null \
        || tr -dc 'a-zA-Z0-9' </dev/urandom | head -c 32
}

function detect_public_ip() {
    local ip endpoint
    for endpoint in ifconfig.me ipinfo.io/ip icanhazip.com; do
        ip=$(curl ${CURL_OPTS} -fsSL --connect-timeout 5 "$endpoint" 2>/dev/null | tr -d '\r\n ')
        if [[ "$ip" =~ ^[0-9.]+$ ]] || [[ "$ip" == *:* && "$ip" =~ ^[0-9a-fA-F:]+$ ]]; then
            echo "$ip"; return 0
        fi
    done
    return 1
}

function write_proxies_to() {
    local out="$1"
    if [ ${#proxies[@]} -eq 0 ]; then
        {
            echo ""
            echo "# Example proxy: expose local ssh on the server's port 6022"
            echo "# [[proxies]]"
            echo "# name = \"${client_name}-ssh\""
            echo "# type = \"tcp\""
            echo "# localIP = \"127.0.0.1\""
            echo "# localPort = 22"
            echo "# remotePort = 6022"
        } >> "$out"
        warn "no --proxy specified; wrote a commented example to $out"
        return 0
    fi
    local proxy p_name p_type p_lip p_lport p_rport
    for proxy in "${proxies[@]}"; do
        IFS=: read -r p_name p_type p_lip p_lport p_rport <<< "$proxy"
        [ -z "$p_lip" ] && p_lip="127.0.0.1"
        [ -z "$p_name" ]  && error "invalid --proxy spec '$proxy' (need NAME:TYPE:LIP:LPORT:RPORT)"
        [ -z "$p_type" ]  && error "invalid --proxy spec '$proxy' (missing type)"
        [ -z "$p_lport" ] && error "invalid --proxy spec '$proxy' (missing local port)"
        [ -z "$p_rport" ] && error "invalid --proxy spec '$proxy' (missing remote port)"
        {
            echo ""
            echo "[[proxies]]"
            echo "name = \"${client_name}-${p_name}\""
            echo "type = \"$p_type\""
            echo "localIP = \"$p_lip\""
            echo "localPort = $p_lport"
            echo "remotePort = $p_rport"
        } >> "$out"
        info "  proxy       : ${client_name}-${p_name} (${p_type}) ${p_lip}:${p_lport} -> :${p_rport}"
    done
}

function write_frpc_header() {
    # writes serverAddr/serverPort/[auth] block to $1, replacing any existing file
    local out="$1" addr="$2" port="$3" tok="$4"
    {
        echo "serverAddr = \"$addr\""
        echo "serverPort = $port"
    } > "$out"
    if [ -n "$tok" ]; then
        {
            echo ""
            echo "[auth]"
            echo "method = \"token\""
            echo "token = \"$tok\""
        } >> "$out"
    fi
}

function parse_frps_field() {
    # $1 = config text, $2 = field regex (alt branches separated by |)
    echo "$1" \
        | grep -E "^[[:space:]]*($2)[[:space:]]*=" \
        | head -n1 | sed 's/.*=[[:space:]]*//' | tr -d '"' | tr -d "'" | tr -d ' '
}

FRP_RELEASES_URL="https://api.github.com/repos/fatedier/frp/releases/latest"

function get_frp_version() {
    if [ -n "$frp_version" ]; then
        echo "$frp_version"
        return 0
    fi
    curl ${CURL_OPTS} -sL "$FRP_RELEASES_URL" \
        | grep '"tag_name"' \
        | head -n1 \
        | cut -d'"' -f4 \
        | sed 's/^v//'
}

function download_frp() {
    local version="$1" os="$2" arch="$3" out_dir="$4"
    local pkg="frp_${version}_${os}_${arch}.tar.gz"
    local url="https://github.com/fatedier/frp/releases/download/v${version}/${pkg}"

    info "downloading $url" >&2
    curl ${CURL_OPTS} -fsSL "$url" -o "$out_dir/$pkg" || error "download failed: $url"
    tar -xzf "$out_dir/$pkg" -C "$out_dir" || error "failed to extract $pkg"
    echo "$out_dir/frp_${version}_${os}_${arch}"
}

function ssh_run() {
    local target="$1" cmd="$2"
    local -a opts=(-p "$ssh_port"
                   -o StrictHostKeyChecking=accept-new
                   -o ConnectTimeout=10
                   -o ServerAliveInterval=15)
    [ -n "$ssh_key" ] && opts+=(-i "$ssh_key")

    if [ -n "$ssh_pass" ]; then
        ensure_sshpass
        sshpass -p "$ssh_pass" ssh "${opts[@]}" "$target" "$cmd"
    else
        ssh "${opts[@]}" "$target" "$cmd"
    fi
}

function install_systemd_unit() {
    local name="$1" exec_path="$2" config_path="$3"

    if ! installed systemctl; then
        warn "systemd not found, skipping ${name}.service install"
        warn "  start manually: $exec_path -c $config_path"
        return 0
    fi

    cat > "/etc/systemd/system/${name}.service" <<EOF
[Unit]
Description=FRP ${name}
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Restart=on-failure
RestartSec=5
ExecStart=${exec_path} -c ${config_path}
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
EOF

    systemctl daemon-reload
    systemctl enable "${name}.service" >/dev/null 2>&1
    systemctl restart "${name}.service"
    info "${name}.service enabled and started"
}

function install_launchd_unit() {
    local name="$1" exec_path="$2" config_path="$3"
    local label="com.fatedier.${name}"
    local plist="/Library/LaunchDaemons/${label}.plist"

    if ! installed launchctl; then
        warn "launchctl not found, skipping launchd unit"
        warn "  start manually: $exec_path -c $config_path"
        return 0
    fi

    cat > "$plist" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>${label}</string>
    <key>ProgramArguments</key>
    <array>
        <string>${exec_path}</string>
        <string>-c</string>
        <string>${config_path}</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/var/log/${name}.log</string>
    <key>StandardErrorPath</key>
    <string>/var/log/${name}.log</string>
</dict>
</plist>
EOF
    chmod 644 "$plist"
    chown root:wheel "$plist" 2>/dev/null || true

    launchctl bootout "system/${label}" >/dev/null 2>&1 || true
    if launchctl bootstrap system "$plist" 2>/dev/null; then
        launchctl enable "system/${label}" >/dev/null 2>&1 || true
        launchctl kickstart -k "system/${label}" >/dev/null 2>&1 || true
    else
        # fallback for older launchctl (pre-10.10)
        launchctl unload -w "$plist" >/dev/null 2>&1 || true
        launchctl load -w "$plist" || error "failed to load ${label} via launchd"
    fi
    info "${label} loaded via launchd ($plist)"
}

function install_service() {
    case "$(uname -s)" in
        Linux)  install_systemd_unit "$@" ;;
        Darwin) install_launchd_unit "$@" ;;
        *) warn "unknown OS, skipping service install" ;;
    esac
}

function install_server() {
    local os arch version tmpdir extracted
    os=$(detect_os); arch=$(detect_arch)
    version=$(get_frp_version)
    [ -z "$version" ] && error "could not detect FRP version"
    info "installing FRP server v${version} (${os}_${arch})"

    tmpdir=$(mktemp -d -t frp-XXXXXXXX) || error "failed to create temp dir"
    trap 'rm -rf "$tmpdir"' EXIT
    extracted=$(download_frp "$version" "$os" "$arch" "$tmpdir")

    mkdir -p "$prefix/bin"
    install -m 0755 "$extracted/frps" "$prefix/bin/frps" || error "failed to install frps binary"
    info "frps installed to $prefix/bin/frps"

    [ -z "$token" ] && token=$(gen_token)

    mkdir -p "$config_dir"
    {
        echo "bindPort = $bind_port"
        echo ""
        echo "[auth]"
        echo "method = \"token\""
        echo "token = \"$token\""
    } > "$config_dir/frps.toml"

    if [ -n "$dashboard_port" ]; then
        [ -z "$dashboard_user" ] && dashboard_user="admin"
        [ -z "$dashboard_pwd" ]  && dashboard_pwd="$(gen_token)"
        {
            echo ""
            echo "[webServer]"
            echo "addr = \"0.0.0.0\""
            echo "port = $dashboard_port"
            echo "user = \"$dashboard_user\""
            echo "password = \"$dashboard_pwd\""
        } >> "$config_dir/frps.toml"
    fi

    chmod 600 "$config_dir/frps.toml"
    info "config written to $config_dir/frps.toml"

    install_service "frps" "$prefix/bin/frps" "$config_dir/frps.toml"

    info ""
    info "FRP server installed:"
    info "  binary       : $prefix/bin/frps"
    info "  config       : $config_dir/frps.toml"
    info "  bind port    : $bind_port"
    info "  auth token   : $token"
    [ -n "$dashboard_port" ] && {
        info "  dashboard    : http://<server>:$dashboard_port"
        info "  dashboard user/pwd : $dashboard_user / $dashboard_pwd"
    }
}

function install_client() {
    [ -z "$ssh_target" ] && error "--client requires SSH target (user@host or host)"

    local server_host
    if [[ "$ssh_target" == *@* ]]; then
        server_host="${ssh_target#*@}"
    else
        server_host="$ssh_target"
    fi
    [ -n "$server_addr" ] && server_host="$server_addr"

    info "fetching FRPS config from $ssh_target..."

    # Try common locations on the remote, falling back through them.
    local remote_cmd remote_config
    remote_cmd="cat \"$config_dir/frps.toml\" 2>/dev/null \
            || cat \"$config_dir/frps.ini\" 2>/dev/null \
            || cat /etc/frp/frps.toml 2>/dev/null \
            || cat /etc/frp/frps.ini 2>/dev/null \
            || cat /usr/local/etc/frp/frps.toml 2>/dev/null"
    remote_config=$(ssh_run "$ssh_target" "$remote_cmd") \
        || error "SSH to $ssh_target failed"
    [ -z "$remote_config" ] && error "no frps config found on remote (looked in $config_dir/, /etc/frp/, /usr/local/etc/frp/)"

    local server_port server_token
    server_port=$(parse_frps_field "$remote_config" "bindPort|bind_port")
    server_token=$(parse_frps_field "$remote_config" "token")

    [ -z "$server_port" ] && error "could not parse bindPort/bind_port from remote config"
    [ -z "$server_token" ] && warn "no auth token found on server — frpc will connect without auth"

    info "  server addr : $server_host:$server_port"
    info "  auth token  : ${server_token:-<none>}"

    local os arch version tmpdir extracted
    os=$(detect_os); arch=$(detect_arch)
    version=$(get_frp_version)
    [ -z "$version" ] && error "could not detect FRP version"
    info "installing FRP client v${version} (${os}_${arch})"

    tmpdir=$(mktemp -d -t frp-XXXXXXXX) || error "failed to create temp dir"
    trap 'rm -rf "$tmpdir"' EXIT
    extracted=$(download_frp "$version" "$os" "$arch" "$tmpdir")

    mkdir -p "$prefix/bin"
    install -m 0755 "$extracted/frpc" "$prefix/bin/frpc" || error "failed to install frpc binary"

    mkdir -p "$config_dir"
    [ -z "$client_name" ] && client_name="$(hostname -s 2>/dev/null || echo client)"

    write_frpc_header "$config_dir/frpc.toml" "$server_host" "$server_port" "$server_token"
    write_proxies_to "$config_dir/frpc.toml"

    chmod 600 "$config_dir/frpc.toml"
    info "config written to $config_dir/frpc.toml"

    install_service "frpc" "$prefix/bin/frpc" "$config_dir/frpc.toml"

    info ""
    info "FRP client installed:"
    info "  binary      : $prefix/bin/frpc"
    info "  config      : $config_dir/frpc.toml"
}

function gen_client_config() {
    [ -z "$gen_client_path" ] && error "--gen-client requires output path"

    local frps_config="$config_dir/frps.toml"
    [ ! -f "$frps_config" ] && [ -f "$config_dir/frps.ini" ] && frps_config="$config_dir/frps.ini"
    [ ! -f "$frps_config" ] && error "no frps config found at $config_dir/frps.toml or .ini — install frps first"

    local frps_text server_port server_token
    frps_text=$(cat "$frps_config")
    server_port=$(parse_frps_field "$frps_text" "bindPort|bind_port")
    server_token=$(parse_frps_field "$frps_text" "token")

    [ -z "$server_port" ] && error "could not parse bindPort from $frps_config"

    local server_host="$server_addr"
    if [ -z "$server_host" ]; then
        server_host=$(detect_public_ip)
        if [ -z "$server_host" ]; then
            server_host=$(hostname -f 2>/dev/null || hostname 2>/dev/null)
            warn "public IP detection failed; using hostname '$server_host' (override with --server-addr)"
        else
            info "auto-detected public IP: $server_host"
        fi
        [ -z "$server_host" ] && {
            warn "could not determine server address; using YOUR_SERVER_ADDR placeholder"
            server_host="YOUR_SERVER_ADDR"
        }
    fi

    [ -z "$client_name" ] && client_name="client"

    info "generating frpc config:"
    info "  output      : $gen_client_path"
    info "  server addr : $server_host:$server_port"
    info "  auth token  : ${server_token:-<none>}"

    mkdir -p "$(dirname "$gen_client_path")"
    write_frpc_header "$gen_client_path" "$server_host" "$server_port" "$server_token"
    write_proxies_to "$gen_client_path"

    chmod 600 "$gen_client_path"
    info "frpc config written to $gen_client_path"
    info ""
    info "Next: copy to NAT'd client and run frpc, e.g.:"
    info "  scp $gen_client_path user@nat-box:/etc/frp/frpc.toml"
    info "  ssh user@nat-box 'frpc -c /etc/frp/frpc.toml'"
}

function usage() {
    cat <<EOF
Usage: $(basename "$0") [options]

Server mode (default — installs frps on this machine):
  --bind-port N           server bind port (default: 7000)
  --token STR             auth token (auto-generated if omitted)
  --dashboard-port N      enable dashboard on port N
  --dashboard-user USER   dashboard user (default: admin)
  --dashboard-pwd PWD     dashboard password (auto-generated if omitted)

Client mode (run on the NAT'd box; fetches config from server via SSH):
  --client user@host      enable client mode; SSH target for fetching frps config
  --ssh-port N            SSH port (default: 22)
  --ssh-key PATH          SSH private key
  --ssh-pass PWD          SSH password (Linux only; or set FRP_SSH_PASS env var)
  --server-addr ADDR      override server address written to frpc.toml
                          (default: host portion of --client)
  --name NAME             client name prefix (default: hostname -s)
  --proxy SPEC            add a proxy entry; SPEC = NAME:TYPE:LIP:LPORT:RPORT
                          LIP defaults to 127.0.0.1 if empty
                          examples:
                            --proxy ssh:tcp::22:6022
                            --proxy web:http:127.0.0.1:8080:0
                          repeat the flag for multiple proxies

Gen-client mode (run on the server, no SSH; emits a frpc.toml to copy out):
  --gen-client PATH       read local frps config and write a frpc.toml to PATH
  --server-addr ADDR      address to embed (default: auto-detected public IP)
  --name NAME             client name prefix (default: client)
  --proxy SPEC            same format as client mode (repeatable)

Common:
  --prefix DIR            install prefix for the binary (default: /usr/local)
                          binary lands at <prefix>/bin/frps or <prefix>/bin/frpc
  --config-dir DIR        config directory (default: /etc/frp)
                          also used as the first remote lookup path in client mode
  --version VERSION       pin a specific FRP version (e.g. 0.62.1); default: latest
  -4 | --ipv4             force IPv4 for downloads
  -6 | --ipv6             force IPv6 for downloads
  -h | --help             this message
EOF
}

# defaults
mode="server"
bind_port=7000
token=""
dashboard_port=""
dashboard_user=""
dashboard_pwd=""
ssh_target=""
ssh_port=22
ssh_key=""
ssh_pass="${FRP_SSH_PASS:-}"
server_addr=""
client_name=""
proxies=()
prefix="/usr/local"
config_dir="/etc/frp"
frp_version=""
gen_client_path=""

POSITIONAL=()
while [ $# -gt 0 ]; do
    case "$1" in
        --bind-port)       bind_port="$2"; shift 2 ;;
        --token)           token="$2"; shift 2 ;;
        --dashboard-port)  dashboard_port="$2"; shift 2 ;;
        --dashboard-user)  dashboard_user="$2"; shift 2 ;;
        --dashboard-pwd)   dashboard_pwd="$2"; shift 2 ;;
        --client)          mode="client"; ssh_target="$2"; shift 2 ;;
        --gen-client)      mode="gen-client"; gen_client_path="$2"; shift 2 ;;
        --ssh-port)        ssh_port="$2"; shift 2 ;;
        --ssh-key)         ssh_key="$2"; shift 2 ;;
        --ssh-pass)        ssh_pass="$2"; shift 2 ;;
        --server-addr)     server_addr="$2"; shift 2 ;;
        --name)            client_name="$2"; shift 2 ;;
        --proxy)           proxies+=("$2"); shift 2 ;;
        --prefix)          prefix="$2"; shift 2 ;;
        --config-dir)      config_dir="$2"; shift 2 ;;
        --version)         frp_version="$2"; shift 2 ;;
        -4 | --ipv4)       CURL_OPTS="-4"; shift ;;
        -6 | --ipv6)       CURL_OPTS="-6"; shift ;;
        -h | --help)       usage; exit 0 ;;
        *) warn "unknown option: $1"; POSITIONAL+=("$1"); shift ;;
    esac
done
set -- "${POSITIONAL[@]}"

[ "$(id -u)" -ne 0 ] && error "Please run as root"

ensure_curl

case "$mode" in
    server)     install_server ;;
    client)     install_client ;;
    gen-client) gen_client_config ;;
    *) error "unknown mode: $mode" ;;
esac
