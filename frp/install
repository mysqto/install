#!/usr/bin/env bash

# FRP installer
# Modes:
#   default:               install frps on this machine
#   --client user@host:    install frpc on this machine, fetching server bindPort/token via SSH
#   --gen-client PATH:     on the server, emit an frpc.toml to PATH (no install, no SSH)
#   --from-config PATH:    install frpc on this machine using a pre-generated frpc.toml
#   --add-proxy SPEC:      append SPEC to the existing frpc.toml and reload the service
#                          (purely additive — preserves serverAddr/token/other proxies)

function warn()  { echo -e "\033[1;33m${*}\033[0m"; }
function error() { echo -e "\033[1;31m${*}\033[0m"; exit 1; }
function info()  { echo -e "\033[1;32m${*}\033[0m"; }
function installed() { command -v "$1" >/dev/null 2>&1; }

CURL_OPTS="${CURL_OPTS:-}"

function detect_os() {
    case "$(uname -s)" in
        Linux)  echo "linux" ;;
        Darwin) echo "darwin" ;;
        *) error "Unsupported OS: $(uname -s)" ;;
    esac
}

function detect_arch() {
    case "$(uname -m)" in
        x86_64 | amd64)   echo "amd64" ;;
        aarch64 | arm64)  echo "arm64" ;;
        i386 | i686)      echo "386" ;;
        armv7* | armv6*)  echo "arm" ;;
        *) error "Unsupported architecture: $(uname -m)" ;;
    esac
}

function install_pkg() {
    if installed apt-get; then
        apt-get update >/dev/null 2>&1
        DEBIAN_FRONTEND=noninteractive apt-get install -y "$@"
    elif installed dnf; then
        dnf install -y "$@"
    elif installed yum; then
        yum install -y "$@"
    elif installed zypper; then
        zypper install -y "$@"
    elif installed pacman; then
        pacman -Sy --noconfirm "$@"
    elif installed apk; then
        apk add --no-cache "$@"
    else
        error "No supported package manager found to install: $*"
    fi
}

function ensure_curl() {
    installed curl && return 0
    warn "curl not found, installing..."
    install_pkg curl
    installed curl || error "curl install failed"
}

function ensure_sshpass() {
    installed sshpass && return 0
    if [ "$(uname -s)" = "Darwin" ]; then
        error "--ssh-pass is not supported on macOS; use --ssh-key (or your ~/.ssh/config)"
    fi
    warn "sshpass not found, installing for password auth..."
    install_pkg sshpass
    installed sshpass || error "sshpass install failed"
}

function gen_token() {
    pwgen -ns 32 1 2>/dev/null \
        || openssl rand -hex 16 2>/dev/null \
        || tr -dc 'a-zA-Z0-9' </dev/urandom | head -c 32
}

function detect_public_ip() {
    local ip endpoint
    for endpoint in ifconfig.me ipinfo.io/ip icanhazip.com; do
        ip=$(curl ${CURL_OPTS} -fsSL --connect-timeout 5 "$endpoint" 2>/dev/null | tr -d '\r\n ')
        if [[ "$ip" =~ ^[0-9.]+$ ]] || [[ "$ip" == *:* && "$ip" =~ ^[0-9a-fA-F:]+$ ]]; then
            echo "$ip"; return 0
        fi
    done
    return 1
}

function write_proxies_to() {
    local out="$1"
    if [ ${#proxies[@]} -eq 0 ]; then
        {
            echo ""
            echo "# Example proxy: expose local ssh on the server's port 6022"
            echo "# [[proxies]]"
            echo "# name = \"${client_name}-ssh\""
            echo "# type = \"tcp\""
            echo "# localIP = \"127.0.0.1\""
            echo "# localPort = 22"
            echo "# remotePort = 6022"
        } >> "$out"
        warn "no --proxy specified; wrote a commented example to $out"
        return 0
    fi
    local proxy p_name p_type p_lip p_lport p_rport
    for proxy in "${proxies[@]}"; do
        IFS=: read -r p_name p_type p_lip p_lport p_rport <<< "$proxy"
        [ -z "$p_lip" ] && p_lip="127.0.0.1"
        [ -z "$p_name" ]  && error "invalid --proxy spec '$proxy' (need NAME:TYPE:LIP:LPORT:RPORT)"
        [ -z "$p_type" ]  && error "invalid --proxy spec '$proxy' (missing type)"
        [ -z "$p_lport" ] && error "invalid --proxy spec '$proxy' (missing local port)"
        [ -z "$p_rport" ] && error "invalid --proxy spec '$proxy' (missing remote port)"
        {
            echo ""
            echo "[[proxies]]"
            echo "name = \"${client_name}-${p_name}\""
            echo "type = \"$p_type\""
            echo "localIP = \"$p_lip\""
            echo "localPort = $p_lport"
            echo "remotePort = $p_rport"
        } >> "$out"
        info "  proxy       : ${client_name}-${p_name} (${p_type}) ${p_lip}:${p_lport} -> :${p_rport}"
    done
}

function write_frpc_header() {
    # writes serverAddr/serverPort/[auth] block to $1, replacing any existing file
    local out="$1" addr="$2" port="$3" tok="$4"
    {
        echo "serverAddr = \"$addr\""
        echo "serverPort = $port"
    } > "$out"
    if [ -n "$tok" ]; then
        {
            echo ""
            echo "[auth]"
            echo "method = \"token\""
            echo "token = \"$tok\""
        } >> "$out"
    fi
}

function parse_frps_field() {
    # $1 = config text, $2 = field regex (alt branches separated by |)
    echo "$1" \
        | grep -E "^[[:space:]]*($2)[[:space:]]*=" \
        | head -n1 | sed 's/.*=[[:space:]]*//' | tr -d '"' | tr -d "'" | tr -d ' '
}

function delete_proxies_by_name() {
    # Strip any [[proxies]] block whose name= value matches one of $2..$N from $1.
    # Used by --add-proxy so re-adding a proxy with the same name replaces (instead of duplicates).
    local config="$1"; shift
    [ ! -f "$config" ] && return 0
    [ $# -eq 0 ] && return 0

    local names_re
    names_re=$(printf '%s|' "$@"); names_re="${names_re%|}"

    local tmp
    tmp=$(mktemp -t frpc-XXXXXX) || error "failed to create temp file"

    awk -v re="^(${names_re})$" '
        function flush() {
            if (in_p) {
                if (name !~ re) printf "%s", buf
            }
            buf = ""; in_p = 0; name = ""
        }
        /^[[:space:]]*\[\[proxies\]\]/ { flush(); in_p = 1; buf = $0 ORS; next }
        /^[[:space:]]*\[/              { flush(); print; next }
        in_p {
            buf = buf $0 ORS
            if ($0 ~ /^[[:space:]]*name[[:space:]]*=/) {
                v = $0
                sub(/.*=[[:space:]]*"?/, "", v)
                sub(/"?[[:space:]]*$/, "", v)
                name = v
            }
            next
        }
        { print }
        END { flush() }
    ' "$config" > "$tmp" && mv "$tmp" "$config"
}

function reload_service() {
    # Restart frps/frpc without re-rendering the unit file.
    local name="$1"
    case "$(uname -s)" in
        Linux)
            installed systemctl || return 0
            if systemctl restart "${name}.service" 2>/dev/null; then
                info "${name}.service restarted"
            else
                warn "could not restart ${name}.service (is it installed?)"
            fi
            ;;
        Darwin)
            installed launchctl || return 0
            local label="com.fatedier.${name}" domain
            if [ "$user_mode" = true ]; then domain="gui/$(id -u)"; else domain="system"; fi
            if launchctl kickstart -k "${domain}/${label}" >/dev/null 2>&1; then
                info "${label} restarted via launchd"
            else
                warn "could not kickstart ${domain}/${label} (is the LaunchAgent/Daemon loaded?)"
            fi
            ;;
    esac
}

function emit_ssh_hint() {
    # Print a ~/.ssh/config snippet for every TCP proxy in $1 that forwards to localPort 22.
    # $2 (optional) = User= value to emit; if empty, the User line is left commented.
    local config="$1" user="$2"
    [ ! -f "$config" ] && return 0

    local snippet
    snippet=$(awk -v user="$user" '
        function flush() {
            if (in_p && ptype=="tcp" && lport=="22" && rport!="" && server!="") {
                printf "Host %s\n", name
                printf "    HostName %s\n", server
                printf "    Port %s\n", rport
                if (user != "") printf "    User %s\n\n", user
                else            printf "    # User <user-on-the-NAT-box>\n\n"
            }
        }
        BEGIN { in_p=0 }
        /^[[:space:]]*#/ { next }
        /^[[:space:]]*serverAddr[[:space:]]*=/ {
            v=$0; sub(/.*=[[:space:]]*"?/,"",v); sub(/"?[[:space:]]*$/,"",v); server=v
        }
        /^[[:space:]]*\[\[proxies\]\]/ { flush(); in_p=1; name=""; ptype=""; lport=""; rport=""; next }
        /^[[:space:]]*\[/             { flush(); in_p=0; next }
        in_p && /^[[:space:]]*name[[:space:]]*=/       { v=$0; sub(/.*=[[:space:]]*"?/,"",v); sub(/"?[[:space:]]*$/,"",v); name=v }
        in_p && /^[[:space:]]*type[[:space:]]*=/       { v=$0; sub(/.*=[[:space:]]*"?/,"",v); sub(/"?[[:space:]]*$/,"",v); ptype=v }
        in_p && /^[[:space:]]*localPort[[:space:]]*=/  { v=$0; sub(/.*=[[:space:]]*/,"",v); sub(/[[:space:]]*$/,"",v); lport=v }
        in_p && /^[[:space:]]*remotePort[[:space:]]*=/ { v=$0; sub(/.*=[[:space:]]*/,"",v); sub(/[[:space:]]*$/,"",v); rport=v }
        END { flush() }
    ' "$config")

    [ -z "$snippet" ] && return 0

    info ""
    info "SSH config — paste into ~/.ssh/config on any machine that can reach the server:"
    info ""
    printf '%s\n' "$snippet"
}

FRP_RELEASES_URL="https://api.github.com/repos/fatedier/frp/releases/latest"

function get_frp_version() {
    if [ -n "$frp_version" ]; then
        echo "$frp_version"
        return 0
    fi
    curl ${CURL_OPTS} -sL "$FRP_RELEASES_URL" \
        | grep '"tag_name"' \
        | head -n1 \
        | cut -d'"' -f4 \
        | sed 's/^v//'
}

function download_frp() {
    local version="$1" os="$2" arch="$3" out_dir="$4"
    local pkg="frp_${version}_${os}_${arch}.tar.gz"
    local url="https://github.com/fatedier/frp/releases/download/v${version}/${pkg}"

    info "downloading $url" >&2
    curl ${CURL_OPTS} -fsSL "$url" -o "$out_dir/$pkg" || error "download failed: $url"
    tar -xzf "$out_dir/$pkg" -C "$out_dir" || error "failed to extract $pkg"
    echo "$out_dir/frp_${version}_${os}_${arch}"
}

function binary_version() {
    # Best-effort version probe — returns the first X.Y.Z found in -v / --version output.
    local bin="$1" out
    [ ! -x "$bin" ] && return 1
    out=$("$bin" -v 2>/dev/null) || out=$("$bin" --version 2>/dev/null) || out=""
    echo "$out" | grep -Eo '[0-9]+\.[0-9]+\.[0-9]+' | head -n1
}

function ensure_binary() {
    # Install $prefix/bin/$component at $version, downloading only if missing or outdated.
    local component="$1" version="$2" os="$3" arch="$4"
    local target="$prefix/bin/$component"
    local current
    current=$(binary_version "$target" 2>/dev/null)

    if [ -n "$current" ] && [ "$current" = "$version" ]; then
        info "$component v$version already installed at $target — skipping download"
        return 0
    fi
    [ -n "$current" ] && info "found $component v${current}, upgrading to v${version}"

    local tmpdir extracted
    tmpdir=$(mktemp -d -t frp-XXXXXXXX) || error "failed to create temp dir"
    extracted=$(download_frp "$version" "$os" "$arch" "$tmpdir")
    mkdir -p "$prefix/bin"
    if ! install -m 0755 "$extracted/$component" "$target"; then
        rm -rf "$tmpdir"
        error "failed to install $component binary"
    fi
    rm -rf "$tmpdir"
    info "$component installed to $target"
}

function ssh_run() {
    local target="$1" cmd="$2"
    local -a opts=(-p "$ssh_port"
                   -o StrictHostKeyChecking=accept-new
                   -o ConnectTimeout=10
                   -o ServerAliveInterval=15)
    [ -n "$ssh_key" ] && opts+=(-i "$ssh_key")

    if [ -n "$ssh_pass" ]; then
        ensure_sshpass
        sshpass -p "$ssh_pass" ssh "${opts[@]}" "$target" "$cmd"
    else
        ssh "${opts[@]}" "$target" "$cmd"
    fi
}

function install_systemd_unit() {
    local name="$1" exec_path="$2" config_path="$3"

    if ! installed systemctl; then
        warn "systemd not found, skipping ${name}.service install"
        warn "  start manually: $exec_path -c $config_path"
        return 0
    fi

    cat > "/etc/systemd/system/${name}.service" <<EOF
[Unit]
Description=FRP ${name}
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
DynamicUser=true
Restart=on-failure
RestartSec=5
ExecStart=${exec_path} -c ${config_path}
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
EOF

    systemctl daemon-reload
    systemctl enable "${name}.service" >/dev/null 2>&1
    systemctl restart "${name}.service"
    info "${name}.service enabled and started"
}

function install_launchd_unit() {
    local name="$1" exec_path="$2" config_path="$3"
    local label="com.fatedier.${name}"
    local plist domain log_path

    if ! installed launchctl; then
        warn "launchctl not found, skipping launchd unit"
        warn "  start manually: $exec_path -c $config_path"
        return 0
    fi

    if [ "$user_mode" = true ]; then
        mkdir -p "$HOME/Library/LaunchAgents" "$HOME/Library/Logs"
        plist="$HOME/Library/LaunchAgents/${label}.plist"
        domain="gui/$(id -u)"
        log_path="$HOME/Library/Logs/${name}.log"
    else
        plist="/Library/LaunchDaemons/${label}.plist"
        domain="system"
        log_path="/var/log/${name}.log"
    fi

    {
        cat <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>${label}</string>
    <key>ProgramArguments</key>
    <array>
        <string>${exec_path}</string>
        <string>-c</string>
        <string>${config_path}</string>
    </array>
EOF
        if [ "$user_mode" = false ]; then
            cat <<EOF
    <key>UserName</key>
    <string>nobody</string>
    <key>GroupName</key>
    <string>nobody</string>
EOF
        fi
        cat <<EOF
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>${log_path}</string>
    <key>StandardErrorPath</key>
    <string>${log_path}</string>
</dict>
</plist>
EOF
    } > "$plist"

    chmod 644 "$plist"
    [ "$user_mode" = false ] && chown root:wheel "$plist" 2>/dev/null || true

    launchctl bootout "${domain}/${label}" >/dev/null 2>&1 || true
    if launchctl bootstrap "$domain" "$plist" 2>/dev/null; then
        launchctl enable "${domain}/${label}" >/dev/null 2>&1 || true
        launchctl kickstart -k "${domain}/${label}" >/dev/null 2>&1 || true
    else
        # fallback for older launchctl (pre-10.10)
        launchctl unload -w "$plist" >/dev/null 2>&1 || true
        launchctl load -w "$plist" || error "failed to load ${label} via launchd"
    fi
    info "${label} loaded via launchd ($plist)"
}

function install_service() {
    case "$(uname -s)" in
        Linux)  install_systemd_unit "$@" ;;
        Darwin) install_launchd_unit "$@" ;;
        *) warn "unknown OS, skipping service install" ;;
    esac
}

function install_server() {
    local os arch version
    os=$(detect_os); arch=$(detect_arch)
    version=$(get_frp_version)
    [ -z "$version" ] && error "could not detect FRP version"
    info "installing FRP server v${version} (${os}_${arch})"

    ensure_binary "frps" "$version" "$os" "$arch"

    if [ -z "$token" ] && [ -f "$config_dir/frps.toml" ]; then
        token=$(parse_frps_field "$(cat "$config_dir/frps.toml")" "token")
        [ -n "$token" ] && info "preserving existing token from $config_dir/frps.toml"
    fi
    [ -z "$token" ] && token=$(gen_token)

    mkdir -p "$config_dir"
    {
        echo "bindPort = $bind_port"
        echo ""
        echo "[auth]"
        echo "method = \"token\""
        echo "token = \"$token\""
    } > "$config_dir/frps.toml"

    if [ -n "$dashboard_port" ]; then
        [ -z "$dashboard_user" ] && dashboard_user="admin"
        [ -z "$dashboard_pwd" ]  && dashboard_pwd="$(gen_token)"
        {
            echo ""
            echo "[webServer]"
            echo "addr = \"0.0.0.0\""
            echo "port = $dashboard_port"
            echo "user = \"$dashboard_user\""
            echo "password = \"$dashboard_pwd\""
        } >> "$config_dir/frps.toml"
    fi

    chmod 644 "$config_dir/frps.toml"
    info "config written to $config_dir/frps.toml"

    install_service "frps" "$prefix/bin/frps" "$config_dir/frps.toml"

    info ""
    info "FRP server installed:"
    info "  binary       : $prefix/bin/frps"
    info "  config       : $config_dir/frps.toml"
    info "  bind port    : $bind_port"
    info "  auth token   : $token"
    [ -n "$dashboard_port" ] && {
        info "  dashboard    : http://<server>:$dashboard_port"
        info "  dashboard user/pwd : $dashboard_user / $dashboard_pwd"
    }
}

function install_client() {
    [ -z "$ssh_target" ] && error "--client requires SSH target (user@host or host)"

    local server_host
    if [[ "$ssh_target" == *@* ]]; then
        server_host="${ssh_target#*@}"
    else
        server_host="$ssh_target"
    fi
    [ -n "$server_addr" ] && server_host="$server_addr"

    info "fetching FRPS config from $ssh_target..."

    # Try common locations on the remote, falling back through them.
    local remote_cmd remote_config
    remote_cmd="cat \"$config_dir/frps.toml\" 2>/dev/null \
            || cat \"$config_dir/frps.ini\" 2>/dev/null \
            || cat /etc/frp/frps.toml 2>/dev/null \
            || cat /etc/frp/frps.ini 2>/dev/null \
            || cat /usr/local/etc/frp/frps.toml 2>/dev/null"
    remote_config=$(ssh_run "$ssh_target" "$remote_cmd") \
        || error "SSH to $ssh_target failed"
    [ -z "$remote_config" ] && error "no frps config found on remote (looked in $config_dir/, /etc/frp/, /usr/local/etc/frp/)"

    local server_port server_token
    server_port=$(parse_frps_field "$remote_config" "bindPort|bind_port")
    server_token=$(parse_frps_field "$remote_config" "token")

    [ -z "$server_port" ] && error "could not parse bindPort/bind_port from remote config"
    [ -z "$server_token" ] && warn "no auth token found on server — frpc will connect without auth"

    info "  server addr : $server_host:$server_port"
    info "  auth token  : ${server_token:-<none>}"

    local os arch version
    os=$(detect_os); arch=$(detect_arch)
    version=$(get_frp_version)
    [ -z "$version" ] && error "could not detect FRP version"
    info "installing FRP client v${version} (${os}_${arch})"

    ensure_binary "frpc" "$version" "$os" "$arch"

    mkdir -p "$config_dir"
    [ -z "$client_name" ] && client_name="$(hostname -s 2>/dev/null || echo client)"

    write_frpc_header "$config_dir/frpc.toml" "$server_host" "$server_port" "$server_token"
    write_proxies_to "$config_dir/frpc.toml"

    chmod 644 "$config_dir/frpc.toml"
    info "config written to $config_dir/frpc.toml"

    install_service "frpc" "$prefix/bin/frpc" "$config_dir/frpc.toml"

    info ""
    info "FRP client installed:"
    info "  binary      : $prefix/bin/frpc"
    info "  config      : $config_dir/frpc.toml"

    emit_ssh_hint "$config_dir/frpc.toml" "${SUDO_USER:-$USER}"
}

function install_client_from_config() {
    [ -z "$from_config_path" ] && error "--from-config requires a path"
    [ ! -f "$from_config_path" ] && error "config file not found: $from_config_path"

    local os arch version
    os=$(detect_os); arch=$(detect_arch)
    version=$(get_frp_version)
    [ -z "$version" ] && error "could not detect FRP version"
    info "installing FRP client v${version} (${os}_${arch})"

    ensure_binary "frpc" "$version" "$os" "$arch"

    mkdir -p "$config_dir"
    if [ "$from_config_path" != "$config_dir/frpc.toml" ]; then
        cp -- "$from_config_path" "$config_dir/frpc.toml" \
            || error "failed to copy $from_config_path to $config_dir/frpc.toml"
    fi
    chmod 644 "$config_dir/frpc.toml"
    info "config installed at $config_dir/frpc.toml"

    install_service "frpc" "$prefix/bin/frpc" "$config_dir/frpc.toml"

    info ""
    info "FRP client installed:"
    info "  binary      : $prefix/bin/frpc"
    info "  config      : $config_dir/frpc.toml"

    emit_ssh_hint "$config_dir/frpc.toml" "${SUDO_USER:-$USER}"
}

function install_add_proxy() {
    [ ${#proxies[@]} -eq 0 ] && error "--add-proxy requires at least one proxy spec"

    local config="$config_dir/frpc.toml"
    [ ! -f "$config" ] && error "no frpc config at $config — install the client first"

    [ -z "$client_name" ] && client_name="$(hostname -s 2>/dev/null || echo client)"

    info "adding ${#proxies[@]} proxy/proxies to $config (client_name=$client_name)"

    # Validate specs up front and collect the full names that write_proxies_to will produce,
    # so we can delete any existing blocks with the same names (replace semantics).
    local -a new_names=()
    local proxy p_name p_type p_lip p_lport p_rport
    for proxy in "${proxies[@]}"; do
        IFS=: read -r p_name p_type p_lip p_lport p_rport <<< "$proxy"
        [ -z "$p_name" ]  && error "invalid --add-proxy spec '$proxy' (need NAME:TYPE:LIP:LPORT:RPORT)"
        [ -z "$p_type" ]  && error "invalid --add-proxy spec '$proxy' (missing type)"
        [ -z "$p_lport" ] && error "invalid --add-proxy spec '$proxy' (missing local port)"
        [ -z "$p_rport" ] && error "invalid --add-proxy spec '$proxy' (missing remote port)"
        new_names+=("${client_name}-${p_name}")
    done

    delete_proxies_by_name "$config" "${new_names[@]}"
    write_proxies_to "$config"
    chmod 644 "$config"

    reload_service "frpc"

    info ""
    info "FRP client config updated:"
    info "  config      : $config"

    emit_ssh_hint "$config" "${SUDO_USER:-$USER}"
}

function gen_client_config() {
    [ -z "$gen_client_path" ] && error "--gen-client requires output path"

    local frps_config="$config_dir/frps.toml"
    [ ! -f "$frps_config" ] && [ -f "$config_dir/frps.ini" ] && frps_config="$config_dir/frps.ini"
    [ ! -f "$frps_config" ] && error "no frps config found at $config_dir/frps.toml or .ini — install frps first"

    local frps_text server_port server_token
    frps_text=$(cat "$frps_config")
    server_port=$(parse_frps_field "$frps_text" "bindPort|bind_port")
    server_token=$(parse_frps_field "$frps_text" "token")

    [ -z "$server_port" ] && error "could not parse bindPort from $frps_config"

    local server_host="$server_addr"
    if [ -z "$server_host" ]; then
        server_host=$(detect_public_ip)
        if [ -z "$server_host" ]; then
            server_host=$(hostname -f 2>/dev/null || hostname 2>/dev/null)
            warn "public IP detection failed; using hostname '$server_host' (override with --server-addr)"
        else
            info "auto-detected public IP: $server_host"
        fi
        [ -z "$server_host" ] && {
            warn "could not determine server address; using YOUR_SERVER_ADDR placeholder"
            server_host="YOUR_SERVER_ADDR"
        }
    fi

    [ -z "$client_name" ] && client_name="client"

    info "generating frpc config:"
    info "  output      : $gen_client_path"
    info "  server addr : $server_host:$server_port"
    info "  auth token  : ${server_token:-<none>}"

    mkdir -p "$(dirname "$gen_client_path")"
    write_frpc_header "$gen_client_path" "$server_host" "$server_port" "$server_token"
    write_proxies_to "$gen_client_path"

    chmod 644 "$gen_client_path"
    info "frpc config written to $gen_client_path"
    info ""
    info "Next: copy to the NAT'd client and install with --from-config, e.g.:"
    info "  scp $gen_client_path user@nat-box:~/frpc.toml"
    info "  ssh user@nat-box 'sudo bash -c \"\$(curl -sL https://debian.lol/frp/install)\" -- --from-config ~/frpc.toml'"

    emit_ssh_hint "$gen_client_path" ""
}

function usage() {
    cat <<EOF
Usage: $(basename "$0") [options]

Server mode (default — installs frps on this machine):
  --bind-port N           server bind port (default: 7000)
  --token STR             auth token (auto-generated if omitted)
  --dashboard-port N      enable dashboard on port N
  --dashboard-user USER   dashboard user (default: admin)
  --dashboard-pwd PWD     dashboard password (auto-generated if omitted)

Client mode (run on the NAT'd box; fetches config from server via SSH):
  --client user@host      enable client mode; SSH target for fetching frps config
  --ssh-port N            SSH port (default: 22)
  --ssh-key PATH          SSH private key
  --ssh-pass PWD          SSH password (Linux only; or set FRP_SSH_PASS env var)
  --server-addr ADDR      override server address written to frpc.toml
                          (default: host portion of --client)
  --name NAME             client name prefix (default: hostname -s)
  --proxy SPEC            add a proxy entry; SPEC = NAME:TYPE:LIP:LPORT:RPORT
                          LIP defaults to 127.0.0.1 if empty
                          examples:
                            --proxy ssh:tcp::22:6022
                            --proxy web:http:127.0.0.1:8080:0
                          repeat the flag for multiple proxies

Gen-client mode (run on the server, no SSH; emits a frpc.toml to copy out):
  --gen-client PATH       read local frps config and write a frpc.toml to PATH
  --server-addr ADDR      address to embed (default: auto-detected public IP)
  --name NAME             client name prefix (default: client)
  --proxy SPEC            same format as client mode (repeatable)

From-config mode (run on the NAT'd box with a pre-generated frpc.toml):
  --from-config PATH      install frpc binary + service using the config at PATH
                          (PATH is copied to <config-dir>/frpc.toml unless it
                          already lives there)

Add-proxy mode (run on the NAT'd box; preserves existing config):
  --add-proxy SPEC        append SPEC to <config-dir>/frpc.toml and restart the
                          service. SPEC = NAME:TYPE:LIP:LPORT:RPORT (same as
                          --proxy). Repeatable. Replaces any existing proxy
                          with the same computed name (<client-name>-NAME).
                          Does not touch the binary, the unit file, or the
                          serverAddr/token header.
  --name NAME             override client name prefix (default: hostname -s)

Common:
  --prefix DIR            install prefix for the binary
                          (default: /usr/local as root, \$HOME/.local in user-mode)
                          binary lands at <prefix>/bin/frps or <prefix>/bin/frpc
  --config-dir DIR        config directory
                          (default: /etc/frp as root, \$HOME/.config/frp in user-mode)
                          also used as the first remote lookup path in client mode

  Note: on macOS, client-side modes (--client / --from-config) auto-switch to
  user-mode when run without sudo: binary in \$HOME/.local/bin, config in
  \$HOME/.config/frp, service registered as a per-user LaunchAgent in
  \$HOME/Library/LaunchAgents (stops at logout). Run with sudo to get a
  system-wide LaunchDaemon instead. Server mode (frps) always needs sudo.
  --version VERSION       pin a specific FRP version (e.g. 0.62.1); default: latest
  -4 | --ipv4             force IPv4 for downloads
  -6 | --ipv6             force IPv6 for downloads
  -h | --help             this message
EOF
}

# defaults
mode="server"
bind_port=7000
token=""
dashboard_port=""
dashboard_user=""
dashboard_pwd=""
ssh_target=""
ssh_port=22
ssh_key=""
ssh_pass="${FRP_SSH_PASS:-}"
server_addr=""
client_name=""
proxies=()
prefix=""
config_dir=""
frp_version=""
gen_client_path=""
from_config_path=""
user_mode=false

POSITIONAL=()
while [ $# -gt 0 ]; do
    case "$1" in
        --bind-port)       bind_port="$2"; shift 2 ;;
        --token)           token="$2"; shift 2 ;;
        --dashboard-port)  dashboard_port="$2"; shift 2 ;;
        --dashboard-user)  dashboard_user="$2"; shift 2 ;;
        --dashboard-pwd)   dashboard_pwd="$2"; shift 2 ;;
        --client)          mode="client"; ssh_target="$2"; shift 2 ;;
        --gen-client)      mode="gen-client"; gen_client_path="$2"; shift 2 ;;
        --from-config)     mode="from-config"; from_config_path="$2"; shift 2 ;;
        --add-proxy)       mode="add-proxy"; proxies+=("$2"); shift 2 ;;
        --ssh-port)        ssh_port="$2"; shift 2 ;;
        --ssh-key)         ssh_key="$2"; shift 2 ;;
        --ssh-pass)        ssh_pass="$2"; shift 2 ;;
        --server-addr)     server_addr="$2"; shift 2 ;;
        --name)            client_name="$2"; shift 2 ;;
        --proxy)           proxies+=("$2"); shift 2 ;;
        --prefix)          prefix="$2"; shift 2 ;;
        --config-dir)      config_dir="$2"; shift 2 ;;
        --version)         frp_version="$2"; shift 2 ;;
        -4 | --ipv4)       CURL_OPTS="-4"; shift ;;
        -6 | --ipv6)       CURL_OPTS="-6"; shift ;;
        -h | --help)       usage; exit 0 ;;
        *) warn "unknown option: $1"; POSITIONAL+=("$1"); shift ;;
    esac
done
set -- "${POSITIONAL[@]}"

# Decide between system-wide install (root) and user-mode install (Darwin only,
# uid != 0). User-mode skips sudo entirely: binary lands in $HOME/.local/bin,
# config in $HOME/.config/frp, and the service registers as a per-user
# LaunchAgent instead of a system-wide LaunchDaemon.
if [ "$(id -u)" -eq 0 ]; then
    user_mode=false
    [ -z "$prefix" ]     && prefix="/usr/local"
    [ -z "$config_dir" ] && config_dir="/etc/frp"
elif [ "$(uname -s)" = "Darwin" ]; then
    if [ "$mode" = "server" ]; then
        error "frps install needs root (binds to a privileged-ish port and writes /Library/LaunchDaemons); re-run with sudo"
    fi
    user_mode=true
    [ -z "$prefix" ]     && prefix="$HOME/.local"
    [ -z "$config_dir" ] && config_dir="$HOME/.config/frp"
    info "running in user-mode (no sudo): binary→$prefix/bin, config→$config_dir, service→LaunchAgent"
else
    error "Please run as root"
fi

ensure_curl

case "$mode" in
    server)      install_server ;;
    client)      install_client ;;
    gen-client)  gen_client_config ;;
    from-config) install_client_from_config ;;
    add-proxy)   install_add_proxy ;;
    *) error "unknown mode: $mode" ;;
esac
