#!/bin/bash
# WireGuard post-down script
# This script is called when a WireGuard interface goes down
# %i will be replaced with the interface name by WireGuard

# Get the default interface dynamically
DEFAULT_INTERFACE=$(ip route show default | awk '/default/ { print $5 }' | head -n1)

if [ -z "$DEFAULT_INTERFACE" ]; then
    echo "Warning: Could not detect default interface"
    # Continue anyway to clean up what we can
fi

echo "Cleaning up forwarding rules for interface %i"

# Remove iptables rules (ignore errors if rules don't exist)
iptables -D FORWARD -i %i -j ACCEPT 2>/dev/null || true
iptables -D FORWARD -o %i -j ACCEPT 2>/dev/null || true

if [ -n "$DEFAULT_INTERFACE" ]; then
    iptables -t nat -D POSTROUTING -o $DEFAULT_INTERFACE -j MASQUERADE 2>/dev/null || true
fi

# Optional: Save iptables rules (uncomment based on your distribution)
# For Debian/Ubuntu with iptables-persistent:
# iptables-save > /etc/iptables/rules.v4
# For CentOS/RHEL/Fedora:
# iptables-save > /etc/sysconfig/iptables

echo "Post-down completed for %i"
