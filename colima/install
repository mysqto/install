#!/usr/bin/env bash
#
# Colima installer for macOS.
#
# Modes:
#   default:              install colima + docker CLI via brew. No service —
#                         user runs `colima start` themselves. Idempotent:
#                         re-runs are cheap.
#
#   --setup:              default + write a per-user LaunchAgent to
#                         ~/Library/LaunchAgents/. VM starts at login and can
#                         be loaded over SSH via LimitLoadToSessionType=Background.
#                         No sudo. Dies when the user logs out.
#
#   --shared:             install + system-wide shared instance:
#                           * colima group (created if missing)
#                           * /opt/colima + /opt/lima owned by --user, setgid
#                             colima so files under the tree inherit the group
#                           * LaunchDaemon at /Library/LaunchDaemons/*.plist,
#                             UserName=--user, GroupName=colima
#                           * socket at /opt/colima/default/docker.sock,
#                             mode 0660, group=colima (via Umask=7 in plist)
#                         Requires sudo. Survives reboot and logout.
#
# Additional flags:
#   --user NAME           (--shared only) user the shared daemon runs as
#                         (default: $SUDO_USER)
#   --members u1,u2,u3    (--shared only) users to add to the colima group
#   -h | --help
#
# Companion for clients (both users on the same Mac in --shared mode):
#   export DOCKER_HOST=unix:///opt/colima/default/docker.sock

function warn()  { echo -e "\033[1;33m${*}\033[0m"; }
function error() { echo -e "\033[1;31m${*}\033[0m"; exit 1; }
function info()  { echo -e "\033[1;32m${*}\033[0m"; }
function installed() { command -v "$1" >/dev/null 2>&1; }

# ---------- OS gate ----------

[ "$(uname -s)" != "Darwin" ] && error "colima/install is macOS-only (Linux users: just apt/dnf install docker)"

# ---------- defaults + argument parsing ----------

setup=false
shared=false
owner_user=""
members=""
recreate_vm=false
# DNS servers baked into the LaunchAgent/LaunchDaemon ProgramArguments as
# `--dns X --dns Y`, so the VM never falls back to `::1` (which fails with
# "connection refused" because there's no DNS server inside the guest).
# Cloudflare + Google as safe defaults; override with --dns 1.1.1.1,8.8.8.8
# or repeat --dns.
dns_servers="1.1.1.1,8.8.8.8"

usage() {
    sed -n '3,32p' "$0" | sed 's/^# //; s/^#//'
    exit 0
}

POSITIONAL=()
while [ $# -gt 0 ]; do
    case "$1" in
        --setup)   setup=true; shift ;;
        --shared)  shared=true; shift ;;
        --user)    owner_user="$2"; shift 2 ;;
        --members) members="$2"; shift 2 ;;
        --dns)
            # accept either comma-separated or repeated
            if [ "$dns_servers" = "1.1.1.1,8.8.8.8" ]; then
                dns_servers="$2"      # first --dns replaces the default
            else
                dns_servers="${dns_servers},$2"
            fi
            shift 2
            ;;
        --recreate-vm)
            # Destroy the VM disk (colima delete) before restart. Necessary
            # when changing DNS on an existing setup: cloud-init only writes
            # /etc/resolv.conf on the VM's first boot, so subsequent stops
            # and starts don't re-provision it. Nuclear — loses local
            # images/containers/volumes.
            recreate_vm=true; shift ;;
        -h|--help) usage ;;
        *) warn "unknown option: $1"; POSITIONAL+=("$1"); shift ;;
    esac
done
set -- "${POSITIONAL[@]}"

# --setup and --shared are mutually exclusive: shared is heavier, wins.
if [ "$setup" = true ] && [ "$shared" = true ]; then
    warn "--setup is redundant with --shared, ignoring --setup"
    setup=false
fi

# ---------- root policy ----------

if [ "$shared" = true ]; then
    [ "$(id -u)" -ne 0 ] && error "--shared requires sudo. Re-run with: sudo bash $(basename "$0") --shared ..."
    # We need SUDO_USER (or explicit --user) so brew can run as a real user.
    [ -z "$owner_user" ] && owner_user="${SUDO_USER:-}"
    [ -z "$owner_user" ] && error "cannot determine daemon user — pass --user NAME or run via sudo (not as root directly)"
    id -u "$owner_user" >/dev/null 2>&1 || error "user '$owner_user' does not exist"
    invoking_user="$owner_user"
else
    [ "$(id -u)" -eq 0 ] && error "default/--setup must be run as your normal user (brew refuses to run as root)"
    invoking_user="$(whoami)"
fi

# ---------- locate brew ----------

brew_bin=""
if [ -x /opt/homebrew/bin/brew ]; then
    brew_bin=/opt/homebrew/bin/brew         # Apple Silicon
elif [ -x /usr/local/bin/brew ]; then
    brew_bin=/usr/local/bin/brew            # Intel
elif installed brew; then
    brew_bin="$(command -v brew)"
else
    error "homebrew not installed — install it first from https://brew.sh"
fi
brew_prefix="$("$brew_bin" --prefix 2>/dev/null)"
[ -z "$brew_prefix" ] && error "could not resolve brew prefix"

# ---------- brew install helper ----------
# brew refuses to run as root, so shell out via `sudo -u` when we're currently
# root. When we're not root, just call directly.

brew_run() {
    if [ "$(id -u)" -eq 0 ]; then
        sudo -u "$invoking_user" "$brew_bin" "$@"
    else
        "$brew_bin" "$@"
    fi
}

brew_ensure() {
    local pkg="$1"
    if brew_run list --formula "$pkg" >/dev/null 2>&1; then
        info "  $pkg already installed"
    else
        info "  installing $pkg via brew..."
        brew_run install "$pkg" || error "brew install $pkg failed"
    fi
}

# Render "1.1.1.1,8.8.8.8" as plist array entries, correctly indented for the
# ProgramArguments block. Emits one <string>--dns</string> / <string>ADDR</string>
# pair per DNS server, no trailing newline.
dns_plist_args() {
    local out="" ifs_save=$IFS
    IFS=,
    local first=true
    for d in $dns_servers; do
        d="${d// /}"        # strip whitespace
        [ -z "$d" ] && continue
        if $first; then first=false; else out+=$'\n'; fi
        out+="        <string>--dns</string>"$'\n'"        <string>$d</string>"
    done
    IFS=$ifs_save
    printf '%s' "$out"
}

# ---------- 1. ensure colima + docker CLI ----------

info "checking / installing colima + docker CLI..."
brew_ensure colima
brew_ensure docker
brew_ensure docker-compose

colima_bin="$brew_prefix/bin/colima"
[ -x "$colima_bin" ] || error "colima binary not found at $colima_bin after install"

info "colima $($colima_bin version 2>&1 | head -n1)"

# ---------- 1a. clean up Docker Desktop leftovers in ~/.docker/config.json ----------
# If the user previously had Docker Desktop, this file will still reference
# docker-credential-desktop (which uninstalled with DD), so every `docker pull`
# fails with "docker-credential-desktop: executable file not found" — even for
# anonymous images. Rewrite credsStore to osxkeychain (bundled with brew's
# docker formula) and drop credHelpers pointing at 'desktop'.
cleanup_docker_desktop_leftovers() {
    local user_home="$1"
    local cfg="$user_home/.docker/config.json"
    [ -f "$cfg" ] || return 0
    grep -q '"desktop"' "$cfg" 2>/dev/null || return 0

    local osxkc="$brew_prefix/bin/docker-credential-osxkeychain"
    local new_helper=""
    [ -x "$osxkc" ] && new_helper=osxkeychain

    python3 - "$cfg" "$new_helper" <<'PY' || warn "  docker config cleanup skipped (python3 issue)"
import json, sys
path, new_helper = sys.argv[1], (sys.argv[2] or None)
with open(path) as f:
    cfg = json.load(f)
changed = False
if cfg.get('credsStore') == 'desktop':
    if new_helper:
        cfg['credsStore'] = new_helper
    else:
        cfg.pop('credsStore', None)
    changed = True
if isinstance(cfg.get('credHelpers'), dict):
    remaining = {k: v for k, v in cfg['credHelpers'].items() if v != 'desktop'}
    if remaining != cfg['credHelpers']:
        if remaining:
            cfg['credHelpers'] = remaining
        else:
            cfg.pop('credHelpers')
        changed = True
if changed:
    with open(path, 'w') as f:
        json.dump(cfg, f, indent=2)
    print(f"  cleaned Docker Desktop credential helpers in {path}")
PY
}

# Only run this in non-root modes (--shared is root and shouldn't touch the
# invoking user's docker config — the setgid/HOME dance is separate).
if [ "$(id -u)" -ne 0 ]; then
    cleanup_docker_desktop_leftovers "$HOME"
fi

# If neither --setup nor --shared, we're done.
if [ "$setup" = false ] && [ "$shared" = false ]; then
    info ""
    info "colima installed. Start manually with:"
    info "  $colima_bin start"
    info ""
    info "Optional next steps:"
    info "  $(basename "$0") --setup      # per-user LaunchAgent (starts at login)"
    info "  sudo bash $(basename "$0") --shared --members u1,u2   # system-wide shared VM"
    exit 0
fi

# ---------- 2a. --setup: per-user LaunchAgent ----------

if [ "$setup" = true ]; then
    label="net.abiosoft.colima.${invoking_user}"
    plist="$HOME/Library/LaunchAgents/${label}.plist"
    log_path="$HOME/Library/Logs/colima.log"

    mkdir -p "$HOME/Library/LaunchAgents" "$HOME/Library/Logs"

    dns_xml="$(dns_plist_args)"

    cat > "$plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>${label}</string>
    <key>ProgramArguments</key>
    <array>
        <string>${colima_bin}</string>
        <string>start</string>
        <string>--foreground</string>
${dns_xml}
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>${brew_prefix}/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <key>LimitLoadToSessionType</key>
    <string>Background</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>${log_path}</string>
    <key>StandardErrorPath</key>
    <string>${log_path}</string>
</dict>
</plist>
PLIST

    chmod 644 "$plist"

    # Target user/<uid> explicitly. `launchctl load -w` is legacy and unreliable
    # from SSH (it exits 0 while printing "Load failed: 5: Input/output error"),
    # `bootstrap gui/<uid>` needs an Aqua session that SSH doesn't have. The
    # modern `bootstrap user/<uid>` pairs cleanly with LimitLoadToSessionType
    # = Background in the plist and works over SSH.
    #
    # NB: no `local` here — this block runs at top-level, not inside a function.
    # `local` outside a function is a soft error and drops the assignment,
    # which then breaks the launchctl call downstream.
    uid_domain="user/$(id -u)"

    # Defensive bootout across every domain macOS might have registered the
    # label in. On Sequoia a stale gui/<uid> or system registration can block
    # a fresh bootstrap into user/<uid> with "Input/output error", even though
    # the plist itself is perfectly valid.
    for d in "system" "gui/$(id -u)" "$uid_domain"; do
        launchctl bootout "${d}/${label}" >/dev/null 2>&1 || true
    done

    # Deal with any pre-existing colima state before we bootstrap the fresh
    # plist. Three real cases we've hit on macOS Sequoia:
    #   (a) VM is genuinely running          → stop, or delete on --recreate-vm
    #   (b) State is corrupt (colima status  → delete forcefully; only way to
    #       fatals with 'error retrieving      unblock. `colima start` would
    #       runtime' etc)                      otherwise say "already running,
    #                                          ignoring" and no-op forever.
    #   (c) Dead socket file lying around    → rm the file, otherwise our
    #       from a prior crash but no daemon    downstream socket-existence
    #       or VM behind it                     check gives a false positive.
    #
    # Use colima's own exit code (not grep on stderr — the msg=running text
    # matches both "colima is running" and "colima not running").
    colima_state=unknown
    if "$colima_bin" status >/dev/null 2>&1; then
        colima_state=running
    elif "$colima_bin" status 2>&1 | grep -q 'error retrieving current runtime\|already running, ignoring'; then
        colima_state=corrupt
    fi

    case "$colima_state" in
        running)
            if [ "$recreate_vm" = true ]; then
                warn "Destroying existing colima VM (--recreate-vm) — loses local images/volumes."
                "$colima_bin" delete --force >/dev/null 2>&1 || true
            else
                info "Stopping running colima VM to apply new plist args..."
                "$colima_bin" stop >/dev/null 2>&1 || true
            fi
            sleep 2
            ;;
        corrupt)
            warn "colima state is corrupt (status fataled) — forcing 'colima delete --force' to recover."
            "$colima_bin" delete --force >/dev/null 2>&1 || true
            sleep 2
            ;;
    esac

    # Remove any stale socket files that survived. Downstream code checks
    # `[ -S "$sock" ]`, which returns true even for a 0-byte orphan from a
    # crashed daemon; that gives a "colima ready after 0s" lie.
    rm -f "$HOME/.colima/default/docker.sock" "$HOME/.colima/default/containerd.sock" 2>/dev/null || true

    # Try bootstrap; show the real error if it fails (previous versions
    # swallowed stderr and reported a stale "loaded" state).
    bootstrap_err="$(launchctl bootstrap "$uid_domain" "$plist" 2>&1)"
    launchctl enable "${uid_domain}/${label}" >/dev/null 2>&1 || true
    launchctl kickstart -k "${uid_domain}/${label}" >/dev/null 2>&1 || true

    # Trust `launchctl list` as the source of truth — bootstrap can exit 0
    # even when the service didn't actually land.
    if launchctl list "${label}" >/dev/null 2>&1; then
        info "${label} loaded in ${uid_domain}"
    else
        [ -n "$bootstrap_err" ] && warn "launchctl bootstrap: $bootstrap_err"
        warn "LaunchAgent didn't stick — falling back to plain 'colima start'."
        warn "The VM will run for this session but won't auto-start on next login."
        warn "To retry the LaunchAgent later:"
        warn "  launchctl bootstrap ${uid_domain} $plist"
        # Boot colima directly so the socket exists and the docker context
        # gets registered. Runs synchronously.
        if command -v colima >/dev/null 2>&1; then
            "$colima_bin" start || warn "colima start failed too — check: colima status"
        fi
    fi

    info ""
    info "Per-user Colima LaunchAgent installed for $invoking_user:"
    info "  plist  : $plist"
    info "  log    : $log_path"
    info ""

    # Wait for the VM to actually come up. First launch pulls a ~500MB Lima
    # image; bound the wait at 3 minutes with heartbeats so Ctrl+C is viable.
    #
    # Probe with a real docker call against an explicit --host, not just the
    # `[ -S "$colima_sock" ]` file-type check. A dead socket file (0 bytes,
    # no daemon) from a prior crashed VM will pass -S and lie about readiness.
    # `docker version` actually talks the protocol and returns non-zero if
    # nothing's listening.
    colima_sock="$HOME/.colima/default/docker.sock"
    docker_alive() {
        [ -S "$colima_sock" ] || return 1
        docker --host "unix://$colima_sock" version --format '{{.Server.Version}}' >/dev/null 2>&1
    }
    info "Waiting for colima socket at $colima_sock (up to 3min, Ctrl+C to skip)..."
    waited=0
    while ! docker_alive && [ $waited -lt 180 ]; do
        sleep 2
        waited=$((waited + 2))
        [ $((waited % 10)) -eq 0 ] && printf '  ...%ds\n' "$waited" >&2
    done

    if docker_alive; then
        info "✓ colima ready after ${waited}s"

        # Point docker CLI at colima. Two mechanisms, in order of preference:
        #   1) `docker context use colima` — clean, portable, requires the
        #      colima context to be registered (colima does this on start,
        #      but a botched previous run may have left it missing).
        #   2) Manually create the colima context.
        #   3) Fall back to a DOCKER_HOST hint if the context store is broken.
        if command -v docker >/dev/null 2>&1; then
            has_colima_ctx=false
            if docker context ls --format '{{.Name}}' 2>/dev/null | grep -qx colima; then
                has_colima_ctx=true
            else
                # Register it ourselves.
                if docker context create colima \
                    --docker "host=unix://$colima_sock" \
                    --description "Colima (created by colima/install)" \
                    >/dev/null 2>&1; then
                    has_colima_ctx=true
                    info "✓ registered docker context 'colima' → unix://$colima_sock"
                fi
            fi

            if [ "$has_colima_ctx" = true ]; then
                current_ctx="$(docker context show 2>/dev/null || echo unknown)"
                if [ "$current_ctx" != "colima" ]; then
                    ctx_err="$(docker context use colima 2>&1 >/dev/null)"
                    if [ $? -eq 0 ]; then
                        info "✓ docker context: $current_ctx → colima"
                    else
                        warn "docker context use colima failed: $ctx_err"
                        warn "  fall back to env var:  set -Ux DOCKER_HOST unix://$colima_sock"
                    fi
                else
                    info "✓ docker context already 'colima'"
                fi
            else
                warn "could not register/find docker context; use DOCKER_HOST instead:"
                warn "  set -Ux DOCKER_HOST unix://$colima_sock   # fish"
                warn "  export DOCKER_HOST=unix://$colima_sock   # bash/zsh"
            fi

            if docker ps >/dev/null 2>&1; then
                info "✓ docker ps succeeds — you're good to go"
            else
                warn "docker ps still failing. Fastest fallback:"
                warn "  set -Ux DOCKER_HOST unix://$colima_sock   # fish"
            fi
        fi
    else
        warn "colima socket didn't appear after 3min."
        warn "  Check the log:  tail $log_path"
        warn "  Once socket exists:  set -Ux DOCKER_HOST unix://$colima_sock  (fish)"
    fi

    info ""
    info "⚠ Agent dies when $invoking_user logs out. Use --shared for reboot persistence."
    exit 0
fi

# ---------- 2b. --shared: system-wide LaunchDaemon ----------

info ""
info "configuring shared Colima instance (owner: $owner_user)..."

# Create the colima group (idempotent).
if ! dseditgroup -o read colima >/dev/null 2>&1; then
    dseditgroup -o create colima || error "failed to create colima group"
    info "  created group: colima"
fi

# Owner must be in the group.
dseditgroup -o edit -a "$owner_user" -t user colima 2>/dev/null || true

# Add additional members.
if [ -n "$members" ]; then
    IFS=,
    for m in $members; do
        [ -z "$m" ] && continue
        if ! id -u "$m" >/dev/null 2>&1; then
            warn "  member '$m' does not exist, skipping"
            continue
        fi
        dseditgroup -o edit -a "$m" -t user colima 2>/dev/null || true
        info "  added $m to colima group"
    done
    unset IFS
fi

# Shared data dirs. Setgid so all descendants inherit the colima group.
for d in /opt/colima /opt/lima; do
    mkdir -p "$d"
    chown "$owner_user:colima" "$d"
    chmod 2775 "$d"
done

# Pre-create the log file — /var/log is root:wheel 755, and the daemon runs as
# a non-root user, so it can't otherwise create its own log for append.
log_path="/var/log/colima-shared.log"
: > "$log_path" 2>/dev/null || touch "$log_path"
chown "$owner_user:colima" "$log_path"
chmod 664 "$log_path"

# Write the LaunchDaemon plist.
label="net.abiosoft.colima.shared"
plist="/Library/LaunchDaemons/${label}.plist"
owner_home="$(dscl . -read "/Users/$owner_user" NFSHomeDirectory 2>/dev/null | awk '{print $2}')"
[ -z "$owner_home" ] && owner_home="/Users/$owner_user"
dns_xml="$(dns_plist_args)"

cat > "$plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>${label}</string>
    <key>UserName</key>
    <string>${owner_user}</string>
    <key>GroupName</key>
    <string>colima</string>
    <key>WorkingDirectory</key>
    <string>/opt/colima</string>
    <key>ProgramArguments</key>
    <array>
        <string>${colima_bin}</string>
        <string>start</string>
        <string>--foreground</string>
${dns_xml}
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>${owner_home}</string>
        <key>COLIMA_HOME</key>
        <string>/opt/colima</string>
        <key>LIMA_HOME</key>
        <string>/opt/lima</string>
        <key>PATH</key>
        <string>${brew_prefix}/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <key>Umask</key>
    <integer>7</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>${log_path}</string>
    <key>StandardErrorPath</key>
    <string>${log_path}</string>
</dict>
</plist>
PLIST

chown root:wheel "$plist"
chmod 644 "$plist"

# Same tri-state handling as --setup — running / corrupt / clean. Runs as
# the owner user because colima's state and lockfiles live in
# COLIMA_HOME=/opt/colima. Use colima's exit code (not grep on stderr,
# which false-positives on "not running").
shared_status_run() {
    sudo -u "$owner_user" \
        COLIMA_HOME=/opt/colima LIMA_HOME=/opt/lima \
        "$colima_bin" "$@"
}
shared_state=unknown
if shared_status_run status >/dev/null 2>&1; then
    shared_state=running
elif shared_status_run status 2>&1 | grep -q 'error retrieving current runtime\|already running, ignoring'; then
    shared_state=corrupt
fi

case "$shared_state" in
    running)
        if [ "$recreate_vm" = true ]; then
            warn "Destroying existing shared colima VM (--recreate-vm) — loses local images/volumes."
            shared_status_run delete --force >/dev/null 2>&1 || true
        else
            info "Stopping running shared colima VM to apply new plist args..."
            shared_status_run stop >/dev/null 2>&1 || true
        fi
        sleep 2
        ;;
    corrupt)
        warn "shared colima state is corrupt — forcing 'colima delete --force' to recover."
        shared_status_run delete --force >/dev/null 2>&1 || true
        sleep 2
        ;;
esac

# Nuke any stale socket files that survived a crash; -S returns true on
# 0-byte orphans, so we can't trust it downstream unless we clear them.
rm -f /opt/colima/default/docker.sock /opt/colima/default/containerd.sock 2>/dev/null || true

# Bootstrap into the system domain.
launchctl bootout "system/${label}" >/dev/null 2>&1 || true
if launchctl bootstrap system "$plist" 2>/dev/null; then
    launchctl enable "system/${label}" >/dev/null 2>&1 || true
    launchctl kickstart -k "system/${label}" >/dev/null 2>&1 || true
else
    launchctl unload -w "$plist" >/dev/null 2>&1 || true
    launchctl load -w "$plist" || error "failed to load ${label} via launchd"
fi

# Wait for the shared socket to come up (first launch pulls the Lima image).
# Same rationale as --setup: don't trust `[ -S ]` on a dead socket file;
# actually probe the docker daemon.
shared_sock="/opt/colima/default/docker.sock"
shared_docker_alive() {
    [ -S "$shared_sock" ] || return 1
    docker --host "unix://$shared_sock" version --format '{{.Server.Version}}' >/dev/null 2>&1
}
info ""
info "Waiting for shared colima socket at $shared_sock (up to 3min, Ctrl+C to skip)..."
waited=0
while ! shared_docker_alive && [ $waited -lt 180 ]; do
    sleep 2
    waited=$((waited + 2))
    [ $((waited % 10)) -eq 0 ] && printf '  ...%ds\n' "$waited" >&2
done

if shared_docker_alive; then
    info "✓ shared colima ready after ${waited}s"
else
    warn "socket didn't appear (or is stale) after 3min — check $log_path"
fi

info ""
info "Shared Colima LaunchDaemon installed:"
info "  plist       : $plist"
info "  data dir    : /opt/colima  (COLIMA_HOME)"
info "  lima dir    : /opt/lima    (LIMA_HOME)"
info "  socket      : /opt/colima/default/docker.sock"
info "  log         : $log_path"
info "  daemon user : $owner_user"
info "  group       : colima"
info ""
info "Each member of the colima group can now do:"
info "  export DOCKER_HOST=unix:///opt/colima/default/docker.sock"
info "  docker ps"
info ""
info "For fish users:"
info "  set -Ux DOCKER_HOST unix:///opt/colima/default/docker.sock"
info ""
info "Group membership takes effect on next login. To refresh the current"
info "shell without logging out: id -Gn should list 'colima'; if it doesn't,"
