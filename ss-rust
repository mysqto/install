#!/bin/bash
# shadowsocks-rust installer (+ optional simple-obfs plugin).
# Hardened systemd unit, random-unused-port verification, env-file persistence.
#
# Behaviour:
#   $0                 install/update ss-server (+ simple-obfs) binaries only
#   $0 --setup         the above, plus write config + provision systemd service
#
# Backward-compatible with the old CLI surface — every flag the previous version
# accepted (-P / -p / -o / -d / -s / -4 / -6) still works the same way.

function warn() {
    echo -e "\033[1;33m${*}\033[0m"
}

function error() {
    echo -e "\033[1;31m${*}\033[0m"
    exit 1
}

function info() {
    echo -e "\033[1;32m${*}\033[0m"
}

function installed() {
    command -v "$1" >/dev/null 2>&1
}

[ "$(id -u)" -ne 0 ] && error "Please run as root"

[ -z "$CURL_OPTS" ] && CURL_OPTS=""
[ -z "$WGET_OPTS" ] && WGET_OPTS=""

# ---------- Bootstrap curl ----------

if ! installed curl; then
    warn "curl is required, will try to install it"
    if installed apt-get; then apt-get update && apt-get install -y curl
    elif installed yum;     then yum update && yum install -y curl
    elif installed dnf;     then dnf update && dnf install -y curl
    elif installed zypper;  then zypper refresh && zypper install -y curl
    elif installed apk;     then apk upgrade && apk add curl --no-cache
    else error "no package manager found, please install curl manually"
    fi
fi
installed curl || error "curl is required, auto installation failed"

# ---------- Args ----------

setup=false
port=""
password=""
obfs_host=""
dns_server=""
method="chacha20-ietf-poly1305"
network="tcp_and_udp"
listen_addr="0.0.0.0"
plugin="simple-obfs"            # simple-obfs | none
force_obfs=false
ssr_version=""

obfs_hosts=(
    "microsoft.com"
    "apple.com"
    "gateway.icloud.com"
    "gateway.messenger.live.com"
    "officecdn.microsoft.com.edgesuite.net"
)

usage() {
    cat <<EOF
Usage: $0 [options]

Installer for shadowsocks-rust (+ simple-obfs plugin).

Common options:
  -P, --port <port>               SS listen port (random unused port if omitted)
  -p, --password <pw>             SS password (random 32-char if omitted)
  -o, --obfs-host <host>          HTTP obfs masquerade host (random from list if omitted)
  -d, --dns-server <ip>           Preferred DNS server (auto-detected if omitted)
  -m, --method <method>           Cipher (default: chacha20-ietf-poly1305)
  -n, --network <net>             tcp | udp | tcp_and_udp (default: tcp_and_udp)
  -L, --listen <addr>             Bind address (default: 0.0.0.0)
  -s, --setup                     Generate config + install/restart systemd unit
  -4 | -6                         Force IPv4/IPv6 for downloads
  -h, --help                      Show this help

Plugin / version pinning:
      --plugin <name>             simple-obfs | none      (default: simple-obfs)
      --force-obfs                Rebuild simple-obfs even if already installed
      --shadowsocks-rust-version <v>   Pin shadowsocks-rust release (default: latest)

Examples:
  $0 --setup                                  # full setup, defaults
  $0 --setup -P 8388 -p mypw -o cdn.example.com
  $0 --setup --plugin none                    # SS without obfs
  $0                                          # install/update binaries only (no service touch)
EOF
    exit 0
}

POSITIONAL=()
while [ $# -gt 0 ]; do
    case "$1" in
        -P | --port)                    port="$2"; shift 2 ;;
        -p | --password)                password="$2"; shift 2 ;;
        -o | --obfs-host)               obfs_host="$2"; shift 2 ;;
        -d | --dns-server)              dns_server="$2"; shift 2 ;;
        -m | --method)                  method="$2"; shift 2 ;;
        -n | --network)                 network="$2"; shift 2 ;;
        -L | --listen)                  listen_addr="$2"; shift 2 ;;
        -s | --setup)                   setup=true; shift ;;
        -4 | --ipv4)                    CURL_OPTS="-4"; WGET_OPTS="-4"; shift ;;
        -6 | --ipv6)                    CURL_OPTS="-6"; WGET_OPTS="-6"; shift ;;
        --plugin)                       plugin="$2"; shift 2 ;;
        --force-obfs)                   force_obfs=true; shift ;;
        --shadowsocks-rust-version)     ssr_version="$2"; shift 2 ;;
        -h | --help)                    usage ;;
        *) POSITIONAL+=("$1"); warn "unknown option $1"; shift ;;
    esac
done
set -- "${POSITIONAL[@]}"

case "$plugin" in
    simple-obfs|none) ;;
    *) error "--plugin must be simple-obfs or none (got: $plugin)" ;;
esac

# ---------- System deps ----------

base_deps=(git pwgen python3)
build_deps_apt=(build-essential autoconf libtool libssl-dev libpcre2-dev libev-dev automake asciidoc xmlto)
build_deps_rpm=(gcc make autoconf libtool openssl-devel pcre-devel libev-devel asciidoc xmlto automake)
build_deps_apk=(build-base autoconf libtool openssl-dev pcre-dev libev-dev asciidoc xmlto automake linux-headers)

want_obfs_build=false
if [ "$plugin" = "simple-obfs" ]; then
    if [ "$force_obfs" = "true" ] || ! installed obfs-server; then
        want_obfs_build=true
    fi
fi

if installed apt-get; then
    pkgs=("${base_deps[@]}")
    [ "$want_obfs_build" = "true" ] && pkgs+=("${build_deps_apt[@]}")
    DEBIAN_FRONTEND=noninteractive apt-get update
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends "${pkgs[@]}"
elif installed yum; then
    pkgs=("${base_deps[@]}")
    [ "$want_obfs_build" = "true" ] && pkgs+=("${build_deps_rpm[@]}")
    yum install -y "${pkgs[@]}"
elif installed dnf; then
    pkgs=("${base_deps[@]}")
    [ "$want_obfs_build" = "true" ] && pkgs+=("${build_deps_rpm[@]}")
    dnf install -y "${pkgs[@]}"
elif installed zypper; then
    pkgs=("${base_deps[@]}")
    [ "$want_obfs_build" = "true" ] && pkgs+=("${build_deps_rpm[@]}")
    zypper install -y "${pkgs[@]}"
elif installed apk; then
    pkgs=("${base_deps[@]}")
    [ "$want_obfs_build" = "true" ] && pkgs+=("${build_deps_apk[@]}")
    apk add --no-cache "${pkgs[@]}"
else
    warn "no known package manager — ensure git/python3/pwgen (+ obfs build deps) are present"
fi

# ---------- Detect arch + libc + OS ----------

os=$(uname -s)
case $os in
    Linux | Darwin) os=$(echo "$os" | tr '[:upper:]' '[:lower:]') ;;
    *) error "Unsupported OS: $os" ;;
esac

arch=$(uname -m)
case $arch in
    x86_64)         arch="x86_64" ;;
    aarch64|arm64)  arch="aarch64" ;;
    i*86)           arch="i686" ;;
    *) error "Unsupported architecture: $arch" ;;
esac

libc=$(ldd "$(readlink -f /bin/sh)" 2>/dev/null | grep -q 'musl' && echo 'musl' || echo 'gnu')

# ---------- Resolve shadowsocks-rust version ----------

ssr_releases_url="https://api.github.com/repos/shadowsocks/shadowsocks-rust/releases"
if [ -z "$ssr_version" ]; then
    ssr_version=$(curl ${CURL_OPTS} -sL "$ssr_releases_url" 2>/dev/null \
        | grep "tag_name" | cut -d'"' -f4 | sed 's/[^0-9.]*//g' | head -n1)
fi
[ -z "$ssr_version" ] && error "Failed to detect shadowsocks-rust version (set --shadowsocks-rust-version to override)"
info "shadowsocks-rust version: $ssr_version"

# shadowsocks-v1.20.1.aarch64-unknown-linux-musl.tar.xz
package_name="shadowsocks-v$ssr_version.$arch-unknown-linux-$libc.tar.xz"
[ "$os" = "darwin" ] && package_name="shadowsocks-v$ssr_version.$arch-apple-darwin.tar.xz"

ssr_download_url="$(curl ${CURL_OPTS} -sL "$ssr_releases_url" 2>/dev/null \
    | grep "browser_download_url" | grep -Eo "https://.*$package_name" | head -n1)"
[ -z "$ssr_download_url" ] && error "Failed to get shadowsocks-rust download url for $package_name"

# ---------- Download + install shadowsocks-rust ----------

ssr_temp_dir=$(mktemp -d -t ssr-XXXXXXXXXX 2>/dev/null) || \
    error "Failed to create temporary directory"
trap 'rm -rf "$ssr_temp_dir"' EXIT

ssr_tmp_file="$ssr_temp_dir/$package_name"
curl ${CURL_OPTS} -fsSL "$ssr_download_url" -o "$ssr_tmp_file" \
    || error "Failed to download shadowsocks-rust"

out_dir="$ssr_temp_dir/out"
mkdir -p "$out_dir"
tar -xJf "$ssr_tmp_file" -C "$out_dir" \
    || error "Failed to extract shadowsocks-rust"

for file in "$out_dir"/*server; do
    [ -x "$file" ] || continue
    file_name=$(basename "$file")
    # Follow shadowsocks-libev naming: ssserver -> ss-server.
    file_name=${file_name/ss/ss-}
    install -m 0755 "$file" "/usr/local/bin/$file_name" \
        || error "Failed to install $file_name"
done

/usr/local/bin/ss-server -V >/dev/null 2>&1 \
    || error "Installed ss-server is not runnable"
info "shadowsocks-rust installed: $(/usr/local/bin/ss-server -V | head -n1)"

# ---------- Build + install simple-obfs (optional) ----------

if [ "$plugin" = "simple-obfs" ]; then
    if [ "$want_obfs_build" = "false" ]; then
        info "simple-obfs already installed (use --force-obfs to rebuild)"
    else
        nproc=$(grep -c ^processor /proc/cpuinfo 2>/dev/null)
        [ -z "$nproc" ] && nproc=4

        simple_obfs_dir=$(mktemp -d -t simple-obfs-XXXXXXXXXX 2>/dev/null) \
            || error "Failed to create simple-obfs temp dir"
        trap 'rm -rf "$ssr_temp_dir" "$simple_obfs_dir"' EXIT

        git clone https://github.com/shadowsocks/simple-obfs.git "$simple_obfs_dir" \
            || error "failed to clone simple-obfs"
        pushd "$simple_obfs_dir" >/dev/null
        git submodule update --init --recursive
        ./autogen.sh                                    || error "simple-obfs: autogen failed"
        ./configure --disable-documentation --prefix=/usr/local \
                                                        || error "simple-obfs: configure failed"
        # shellcheck disable=SC2086
        make -j"$nproc"                                 || error "simple-obfs: build failed"
        make install                                    || error "simple-obfs: install failed"
        popd >/dev/null
        info "simple-obfs installed: $(obfs-server -h 2>&1 | grep -Eo 'v[0-9.]+' | head -n1)"
    fi
elif [ "$plugin" = "none" ]; then
    info "skipping simple-obfs (--plugin none)"
fi

# ---------- Stop here if not --setup ----------

if [ "$setup" != "true" ]; then
    info "binaries installed."
    info "re-run with --setup to provision config + systemd service."
    exit 0
fi

# ---------- --setup helpers ----------

# Random-but-unused-port picker. Returns 0 (true) when port is in use.
port_in_use() {
    local p=$1
    if installed ss; then
        ss -Hltun "sport = :$p" 2>/dev/null | grep -q . && return 0
        return 1
    fi
    if python3 - "$p" <<'PY'
import socket, sys
p = int(sys.argv[1])
for fam in (socket.AF_INET6, socket.AF_INET):
    for typ in (socket.SOCK_STREAM, socket.SOCK_DGRAM):
        s = socket.socket(fam, typ)
        try:
            s.bind(("" if fam == socket.AF_INET else "::", p))
        except OSError:
            sys.exit(1)
        finally:
            s.close()
sys.exit(0)
PY
    then
        return 1
    else
        return 0
    fi
}

random_unused_port() {
    local min=10000 max=65000 p
    for _ in $(seq 1 100); do
        p=$(shuf -i ${min}-${max} -n1 2>/dev/null) || return 1
        if ! port_in_use "$p"; then
            echo "$p"; return 0
        fi
    done
    return 1
}

random_obfs_host() {
    local n=${#obfs_hosts[@]}
    [ "$n" -gt 0 ] || { echo "microsoft.com"; return; }
    echo "${obfs_hosts[$((RANDOM % n))]}"
}

gen_password() {
    pwgen -ns 32 1 2>/dev/null \
        || openssl rand -base64 32 2>/dev/null \
        || tr -dc 'a-zA-Z0-9' </dev/urandom | head -c 32
}

# ---------- --setup: resolve missing settings ----------

shadowsocks_config_file="/etc/shadowsocks/config.json"
shadowsocks_libev_config_file="/etc/shadowsocks-libev/config.json"
shadowsocks_default_file="/etc/default/shadowsocks"
shadowsocks_systemd_service_file="/lib/systemd/system/shadowsocks.service"

# Preserve existing values from any prior config so re-running --setup is idempotent.
existing_config=""
if [ -f "$shadowsocks_libev_config_file" ]; then
    warn "shadowsocks-libev config found, will read defaults from it"
    existing_config="$shadowsocks_libev_config_file"
    shadowsocks_config_file="$shadowsocks_libev_config_file"
elif [ -f "$shadowsocks_config_file" ]; then
    existing_config="$shadowsocks_config_file"
fi

if [ -n "$existing_config" ]; then
    [ -z "$password" ]  && password=$(grep   -Eo "\"password\"\s*:\s*\"[^\"]+\""   "$existing_config" 2>/dev/null | cut -d'"' -f4)
    [ -z "$port" ]      && port=$(grep       -Eo "\"server_port\"\s*:\s*[0-9]+"   "$existing_config" 2>/dev/null | grep -Eo '[0-9]+')
    [ -z "$obfs_host" ] && obfs_host=$(grep  -Eo 'obfs-host=[^;"]+'                "$existing_config" 2>/dev/null | cut -d'=' -f2)
    [ -z "$dns_server" ] && dns_server=$(grep -Eo "\"dns_server\"\s*:\s*\"[^\"]+\"" "$existing_config" 2>/dev/null | cut -d'"' -f4)
fi

if [ -z "$port" ]; then
    port=$(random_unused_port) || error "could not find an unused port after 100 tries"
    info "selected random unused port: $port"
elif port_in_use "$port"; then
    error "requested port $port is already in use"
fi

[ -z "$password" ] && password=$(gen_password)
[ "$plugin" = "simple-obfs" ] && [ -z "$obfs_host" ] && obfs_host=$(random_obfs_host)

if [ -z "$dns_server" ]; then
    v4_route=$(ip -4 route 2>/dev/null)
    v6_route=$(ip -6 route 2>/dev/null)
    if [ -z "$v4_route" ] && [ -n "$v6_route" ]; then
        dns_server="2001:4860:4860::8888"
    else
        dns_server="1.1.1.1"
    fi
fi

# ---------- --setup: write config.json ----------

mkdir -p "$(dirname "$shadowsocks_config_file")"

config_tmp=$(mktemp)
if [ "$plugin" = "simple-obfs" ]; then
    cat >"$config_tmp" <<EOF
{
        "server"      : "${listen_addr}",
        "server_port" : ${port},
        "password"    : "${password}",
        "timeout"     : 300,
        "method"      : "${method}",
        "mode"        : "${network}",
        "fast_open"   : true,
        "plugin"      : "obfs-server",
        "plugin_opts" : "obfs=http;obfs-host=${obfs_host}"
}
EOF
else
    cat >"$config_tmp" <<EOF
{
        "server"      : "${listen_addr}",
        "server_port" : ${port},
        "password"    : "${password}",
        "timeout"     : 300,
        "method"      : "${method}",
        "mode"        : "${network}",
        "fast_open"   : true
}
EOF
fi
install -m 0644 "$config_tmp" "$shadowsocks_config_file"
rm -f "$config_tmp"

# ---------- --setup: write /etc/default/shadowsocks ----------

cat >"$shadowsocks_default_file" <<EOF
# Defaults for shadowsocks initscript
# sourced by /etc/init.d/shadowsocks
# installed at $shadowsocks_default_file by the maintainer scripts

#
# This is a POSIX shell fragment
#
# Note: START, GROUP and MAXFD options are not recognized by systemd.
# Please change those settings in the corresponding systemd unit file.

# Enable during startup?
START=yes

# Configuration file
CONFFILE=$shadowsocks_config_file

# Extra command line arguments
DAEMON_ARGS=-v

# User and group to run the server as
USER=nobody
GROUP=nogroup

# Number of maximum file descriptors
MAXFD=32768
EOF

# ---------- --setup: write systemd unit ----------

cat >"$shadowsocks_systemd_service_file" <<UNIT
#  This file is part of shadowsocks.
#
#  shadowsocks is free software; you can redistribute it and/or modify
#  it under the terms of the GNU General Public License as published by
#  the Free Software Foundation; either version 3 of the License, or
#  (at your option) any later version.
#
#  This file is default for Debian packaging. See also
#  $shadowsocks_default_file for environment variables.

[Unit]
Description=shadowsocks default server service
Documentation=man:shadowsocks(8)
After=network-online.target
Wants=network-online.target

[Service]
Restart=on-failure
RestartSec=5
Type=simple
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
DynamicUser=true
EnvironmentFile=$shadowsocks_default_file
LimitNOFILE=32768
ExecStart=/usr/local/bin/ss-server -c \$CONFFILE \$DAEMON_ARGS

[Install]
WantedBy=multi-user.target
UNIT

systemctl daemon-reload
systemctl enable shadowsocks.service >/dev/null 2>&1
systemctl restart shadowsocks.service

sleep 1
if ! systemctl is-active --quiet shadowsocks.service; then
    warn "shadowsocks service failed to start — check: journalctl -u shadowsocks -e"
    exit 1
fi

info "shadowsocks-rust settings:"
info "  listen       : $listen_addr:$port"
info "  password     : $password"
info "  method       : $method"
info "  network      : $network"
info "  plugin       : $plugin"
[ "$plugin" = "simple-obfs" ] && info "  obfs-host    : $obfs_host"
info "  dns-server   : $dns_server"
info "  config       : $shadowsocks_config_file"
info "  env-file     : $shadowsocks_default_file"
info "shadowsocks service is running"
