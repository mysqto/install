#!/usr/bin/env bash

if ((EUID != 0)); then
    echo "Granting root privileges for ""$(basename "$0")"
    if [ -t 1 ]; then
        sudo "$0" "$@"
    else
        exec 1>output_file
        gksu "$0" "$@"
    fi
    exit
fi

function warn() {
    echo -e "\033[33m$1\033[0m"
}

function error() {
    echo -e "\033[31m$1\033[0m"
    exit 1
}

function info() {
    echo -e "\033[32m$1\033[0m"
}

base_url="https://debian.lol"
github_base="https://raw.githubusercontent.com/mysqto/install/gh-pages"

# check connection to base url
if ! curl -sL --connect-timeout 5 "$base_url" >/dev/null 2>&1; then
    warn "Failed to connect to $base_url"
    warn "try to use github url $github_base"
    base_url="$github_base"
    # check connection to base url again
    if ! curl -sL --connect-timeout 5 "$base_url" >/dev/null 2>&1; then
        error "Failed to connect to $base_url"
    fi
fi

lookbusy_base="http://www.devin.com/lookbusy/"

function get_disk() {
    lsblk -oMOUNTPOINT,PKNAME -P | grep 'MOUNTPOINT="/"' | cut -d'"' -f4 | sed 's/[0-9]//g'
}

function distro() {
    cat /etc/*-release 2>/dev/null | grep -Eo 'ID=\w+' | cut -d'=' -f2 | head -n1 | tr '[:upper:]' '[:lower:]' 2>/dev/null ||
        cat /etc/*-release 2>/dev/null | grep -Eo 'ID_LIKE=\w+' | cut -d'=' -f2 | head -n1 | tr '[:upper:]' '[:lower:]' 2>/dev/null ||
        cat /etc/*-release 2>/dev/null | grep -Eo 'DISTRIB_ID=\w+' | cut -d'=' -f2 | head -n1 | tr '[:upper:]' '[:lower:]' 2>/dev/null
}

function arch() {
    arch=$(dpkg --print-architecture 2>/dev/null) || {
        case $(uname -m) in
        x86_64)
            arch=amd64
            ;;
        aarch64)
            arch=arm64
            ;;
        i386)
            arch=i386
            ;;
        *)
            error 'No "--architecture" specified'
            ;;
        esac
    }
    echo "$arch"
}

function add_cronjob() {
    username="$1"
    # all the other arguments are the command
    cron="${*:2}"

    # check if the user exists
    if ! id -u "$username" >/dev/null 2>&1; then
        error "user $username does not exist"
    fi

    cron_checksum=$(echo "$cron" | md5sum | cut -d' ' -f1)

    # check cron whether exists with the same checksum
    if crontab -u "$username" -l 2>/dev/null | grep -q "$cron_checksum"; then
        warn "command already exists"
        return 0
    fi

    # add the job to crontab
    (
        crontab -u "$username" -l 2>/dev/null
        echo "$cron # $cron_checksum"
    ) | crontab -u "$username" -
}

function installed() {
    command -v "$1" >/dev/null 2>&1
}

function updateable() {
    apt-get update >/dev/null 2>&1
    available=$(apt list --upgradable 2>/dev/null | grep -c upgradable)
    [ "$available" -gt 0 ] || return 1
}

function updatable_without_kernel() {
    apt-get update >/dev/null 2>&1
    available=$(apt list --upgradable 2>/dev/null | grep -v linux-image | grep -c upgradable)
    [ "$available" -gt 0 ] || return 1
}

function kernal_updateable() {
    apt-get update >/dev/null 2>&1
    available=$(apt list --upgradable 2>/dev/null | grep upgradable | grep -c linux-image)
    [ "$available" -gt 0 ] || return 1
}

function remove_old_kernels() {
    old_kernels=$(dpkg -l "linux-"{image,headers}"-*" 2>/dev/null | awk '/^ii/{print $2}' | grep -E '[0-9]+\.[0-9]+\.[0-9]+' | grep -v "$(uname -r | cut -d- -f-2)")
    [ -z "$old_kernels" ] && warn "no old kernels to remove" && return 0
    for kernel in $old_kernels; do
        apt -y purge "$kernel"
    done
    apt -y autoremove && apt -y autoclean
}

function fix_grub() {
    dist="$(distro)"
    [ "$dist" != "debian" ] && warn "not an Debian server, no need to fix grub" && return 0
    [ ! -d /sys/firmware/efi ] && warn "not an EFI system, no need to fix grub" && return 0

    # re-install grub to fix the grub menu
    disk=$(get_disk)
    [ -z "$disk" ] && error "failed to get the disk"
    [[ "$disk" =~ ^/dev/ ]] || disk="/dev/$disk"
    local arch=
    arch="$(uname -m)" || error "failed to get the architecture"
    grub_target="x86_64-efi"
    [ "$arch" == "aarch64" ] && grub_target="arm64-efi"
    grub-install "$disk" --target="$grub_target" --efi-directory=/boot/efi --boot-directory=/boot --recheck
    update-grub
}

function update() {
    info "checking for updates"
    if kernal_updateable; then
        warn "kernal updateable, update and reboot the server"
        apt -y upgrade
        reboot
    elif updateable; then
        warn "update available, update the server"
        apt -y upgrade
        [ -f "/var/run/reboot-required" ] && warn "reboot required" && reboot
    fi
}

function upgrade() {
    dist="$(distro)"
    [ "$dist" != "Ubuntu" ] && error "not an Ubuntu server, no need to upgrade"
    current_version=$(lsb_release -r | awk '{print $2}')
    [ "$current_version" == "22.04" ] && error "already on 22.04, no need to upgrade"
    info "upgrading the server from $current_version to 22.04"
    [ -f /etc/apt/apt.conf.d/local ] && cp /etc/apt/apt.conf.d/local /etc/apt/apt.conf.d/local.bak
    info 'DPkg::options { "--force-confdef"; "--force-confold"; }' >/etc/apt/apt.conf.d/local
    DEBIAN_FRONTEND=noninteractive /usr/bin/do-release-upgrade -d -f DistUpgradeViewNonInteractive
    [ -f /etc/apt/apt.conf.d/local.bak ] && cp /etc/apt/apt.conf.d/local.bak /etc/apt/apt.conf.d/local
    reboot
}

function update_ss() {
    curl -sL "$base_url/ss-libev" | bash -s --
}

function update_ss_obfs_host() {
    obfs_host="$1"
    [ -z "$obfs_host" ] && error "obfs host is required"
    ss_libev_config="/etc/shadowsocks-libev/config.json"
    [ ! -f "$ss_libev_config" ] && error "shadowsocks-libev config file not found"
    if grep -q "$obfs_host" "$ss_libev_config"; then
        warn "obfs host already exists"
        return 0
    fi
    sed -i -E 's/obfs-host=[^;"]+/obfs-host='"$obfs_host"'/g' "$ss_libev_config"

    if grep -q "$obfs_host" "$ss_libev_config"; then
        info "obfs host updated, restarting shadowsocks-libev..."
        sudo systemctl restart shadowsocks-libev
        return 0
    else
        error "failed to update obfs host"
    fi
}

function shadow_tls() {
    curl -sL "$base_url/Surge/Snell/install" | bash -s -- --shadow-tls
}

function install_speedtest() {
    prefix=/usr/local
    manpath=$prefix/share/man/man5
    pkg_info_url='https://raw.githubusercontent.com/teamookla/homebrew-speedtest/master/speedtest.rb'
    pkg_version="$(curl -sL "$pkg_info_url" | grep 'version \".*\"' | cut -d'"' -f2)"
    [ -z "$pkg_version" ] && error "failed to get the latest speedtest-cli versuib"
    pkg_url="https://install.speedtest.net/app/cli/ookla-speedtest-$pkg_version-linux-$(uname -m).tgz"
    pkg_url=${pkg_url//\\/}
    pkg_name=$(basename "$pkg_url")
    tmp_dir=$(mktemp -d -t speedtest-cli-XXXXXXXXXX 2>/dev/null)
    [ -z "$tmp_dir" ] && error "failed to create a temp dir"
    target_pkg="$tmp_dir/$pkg_name"
    curl -sL "$pkg_url" -o "$target_pkg"
    [ ! -f "$target_pkg" ] && error "failed to download the package"
    tar -xzf "$target_pkg" -C "$tmp_dir"
    [ ! -f "$tmp_dir/speedtest" ] && error "failed to extract the package"
    mv "$tmp_dir/speedtest" $prefix/bin/speedtest
    chmod +x $prefix/bin/speedtest
    [ ! -d "$manpath" ] && mkdir -p "$manpath"
    [ -d "$manpath" ] && mv "$tmp_dir/speedtest.5" "$manpath"
    rm -rf "$tmp_dir"
    info "speedtest-cli installed"
}

function run_speedtest() {
    if ! installed speedtest; then
        warn "speedtest-cli not installed, installing it"
        install_speedtest
    fi
    if ! installed speedtest; then
        error "failed to install speedtest-cli"
    fi

    info "running speedtest"
    speedtest --accept-license --accept-gdpr --format=json-pretty
}

function install_pyenv() {
    username="$1"
    [ -z "$username" ] && error "username is required when installing pyenv"
    su - "$username" -c "rm -rf ~/.pyenv && curl -sL https://pyenv.run | bash"
    su - "$username" -c "curl -sL https://git.io/fisher | source && fisher install jorgebucaran/fisher && fisher install oh-my-fish/plugin-pyenv"
}

function self_update() {
    new_script=$(curl -sL "$base_url/im")
    [ -z "$new_script" ] && error "failed to get the latest script"
    script_path=$(readlink -f "$0")
    [ ! -f "$script_path" ] && error "failed to get the script path"
    (sleep 1 && cat <<<"$new_script" >"$script_path" && chmod +x "$script_path" && warn "script updated, please run it again") &
    info "im is updating, please wait"
}

function provision() {
    local user="$1"
    [ -z "$user" ] && error "username is required when provisioning the server"
    curl -sL "$base_url/provision" | bash -s -- -u "$user" -s
}

function reset() {
    [ "$#" != 2 ] && error "usage: $0 reset <username>"
    local system="$1"
    local user="$2"
    [ -z "$user" ] && error "username is required when reseting the server"
    case "$system" in
    ubuntu)
        curl -sL "$base_url/ubuntu" | bash -s -- -u "$user"
        ;;
    *)
        curl -sL "$base_url/debian" | bash -s -- --user "$user" --provision
        ;;
    esac
}

function reboot() {
    warn "rebooting the server"
    /sbin/reboot
}

function do_all() {
    current_version=$(lsb_release -r | awk '{print $2}')
    if [ "$current_version" == "22.04" ]; then
        update
    else
        info upgraading server from "$current_version" to 22.04
        update
        upgrade
    fi
}

function cleanup() {
    apt -y autoremove && apt -y autoclean
}

function netflix_test() {
    wd=$(mktemp -d -t netflix-XXXXXXXXXXXXXXXX 2>/dev/null)
    [ -z "$wd" ] && error "failed to create a temp dir"
    pushd "$wd" >/dev/null 2>&1 || return 1
    rm -rf netflix-verify && git clone https://github.com/sjlleo/netflix-verify.git >/dev/null 2>&1 &&
        cd netflix-verify && go run main.go && cd .. && rm -rf netflix-verify
    popd >/dev/null 2>&1 || return 1
    rm -rf "$wd"
}

function midea_unlock_test() {
    wd=$(mktemp -d -t midea-XXXXXXXXXXXXXXXX 2>/dev/null)
    [ -z "$wd" ] && error "failed to create a temp dir"
    pushd "$wd" >/dev/null 2>&1 || return 1
    # TODO: add midea unlock test
    popd >/dev/null 2>&1 || return 1
    rm -rf "$wd"
}

function install_edge_kernel() {
    current_version=$(lsb_release -r | awk '{print $2}')
    apt -y update 2>/dev/null
    edge_kernel=$(apt-cache search -q linux-image-generic-hwe-"$(lsb_release -r | awk '{print $2}')"-edge 2>/dev/null | cut -d' ' -f1)
    [ -z "$edge_kernel" ] && error "failed to get the edge kernel"
    if dpkg -s "$edge_kernel" >/dev/null 2>&1; then
        warn "edge kernel already installed"
        return 0
    fi
    apt -y install "$edge_kernel" && info "edge kernel installed"
    warn "rebooting the server"
    /sbin/reboot
}

function install_lookbusy() {
    remote_url=$(curl -sL $lookbusy_base | grep -oP 'href="\K[^"]+.tar.gz' | head -n 1 | sed 's/ //g')
    [ -z "$remote_url" ] && error "failed to get the remote url"
    remote_version=$(echo "$remote_url" | grep -oP 'lookbusy-\K[^"]+.tar.gz' | sed 's/\.tar\.gz//g')
    [ -z "$remote_version" ] && error "failed to get the remote version"
    local_version=$(lookbusy -V 2>/dev/null | grep -oP 'lookbusy ([0-9]+([.][0-9]+)+)' | awk '{print $2}')
    [ -z "$local_version" ] || [ "$local_version" != "$remote_version" ] && {
        tmp_dir=$(mktemp -d -t lookbusy-XXXXXXXXXXXXXXXX 2>/dev/null)
        [ -z "$tmp_dir" ] && error "failed to create a temp dir"
        pushd "$tmp_dir" >/dev/null 2>&1 || return 1
        curl -sL "$lookbusy_base$remote_url" -o lookbusy.tar.gz || error "failed to download the lookbusy package"
        tar -xvf lookbusy.tar.gz --strip-components=1 --exclude=.svn || error "failed to extract the lookbusy package"
        ./configure && make && make install
        popd >/dev/null 2>&1 || return 1
        rm -rf "$tmp_dir"
    }
}

function enable_lookbusy() {
    username="$1"
    [ -z "$username" ] && error "username is required when enabling lookbusy"
    if ! installed lookbusy; then
        warn "lookbusy is not installed"
        warn "installing lookbusy"
        install_lookbusy
    fi
    if ! installed lookbusy; then
        error "failed to install lookbusy"
    fi

    # get 10% of the available memory
    mem=$(free -m | grep Mem | awk '{print $2}')
    mem=$((mem / 10))
    # create a cron job to run lookbusy every day from 02:30 GMT+8 with user $username
    add_cronjob "$username" "30 2 * * * timeout 4h lookbusy -c 10-20 -r curve -m $mem""mb -M 100"

    if ! installed speedtest; then
        warn "speedtest is not installed"
        warn "installing speedtest"
        install_speedtest
    fi
    if ! installed speedtest; then
        error "failed to install speedtest"
    fi
    # create a cron job to run speedtest every day at 02:00 GMT+8 with user $username
    add_cronjob "$username" "0 2 * * * speedtest --accept-license --accept-gdpr"
}

function install_docker() {
    username="$1"
    [ -z "$username" ] && {
        warn "no user specified, please add your user to docker group manually"
    }
    curl -sL "$base_url/docker" | bash

    [ -n "$username" ] && usermod -aG docker "$username"
}

_install_pyenv=false
_install_speedtest=false
_install_lookbusy=false
_update=false
_update_ss=false
_update_ss_obfs_host=false
_ss_obfs_host=""
_upgrade=false
_remove_old_kernels=false
_auto=false
_reset=false
_reset_with_debian=false
_reset_with_ubuntu=false
_reboot=false
_provision=false
_self_update=false
_cleanup=false
_unlock_test=false
_netflix_test=false
_edge_kernel=false
_enable_lookbusy=false
_speedtest=false
_distro=false
_fix_grub=false
_shadow_tls=false
_install_docker=false
username=""
_host=""

function usage() {
    info "Usage: $(basename "$0") [options]"
    info "Options:"
    info "  -h, --help                              show this help message and exit"
    info "  -d, --distro,                           show the distro"
    info "  -f, --fix-grub,                          fix grub boot menu"
    info "  -ist, --install-speedtest,              install speedtest-cli"
    info "  -ilb, --install-lookbusy,               install lookbusy"
    info "  -ipe, --install-pyenv,                  install pyenv"
    info "  -c, --cleanup,                          cleanup the server"
    info "  -e, --edge-kernel,                      install edge kernel"
    info "  -l, --lookbusy,                         enable lookbusy"
    info "  -uu, --update,                          update the server"
    info "  -uuu, --ugrade,                         upgrade the server if needed"
    info "  -ui, --self-update,                     update $(basename "$0")"
    info "  -uss, --update-shadowsocks,             update shadowsocks-libev"
    info "  -usoh, --update-shadowsocks-obfs-host   update shadowsocks-libev with obfs host"
    info "  -ro, --remove-old-kernels,              remove old kernels"
    info "  -a, --auto,                             auto update or upgrade the server"
    info "  -rr, --reset,                           reset the server, need -u to specify the username"
    info "  -rrd, --reset-with-debian,              reset the server with debian, need -u to specify the username"
    info "  -rru, --reset-with-ubuntu,              reset the server with ubuntu, need -u to specify the username"
    info "  -r, --reboot,                           reboot the server"
    info "  -s, --midea-unlock-test,                stream media unlock test"
    info "  -ss, --shadowsocks,                     enable shadowsocks"
    info "  -stls, --shadow-tls,                    enable snell and shadow-tls"
    info "  -st, --speedtest,                       run speedtest"
    info "  -p, --provision,                        provision the server, need -u to specify the username"
    info "  -u, --username,                         specify the username when reseting or provisioning the server"
    info "  -nf, --netflix-test,                    netflix unlock test"
    info "  --docker,                               install docker"
}

POSITIONAL=()

while [ $# -gt 0 ]; do
    case "$1" in
    -d | --distro)
        _distro=true
        shift 1
        ;;
    --docker)
        _install_docker=true
        shift 1
        ;;
    -f | --fix-grub)
        _fix_grub=true
        shift 1
        ;;
    -uu | --update)
        _update=true
        shift 1
        ;;
    -uuu | --ugrade)
        _upgrade=true
        shift 1
        ;;
    -ui | --self-update)
        _self_update=true
        shift 1
        ;;
    -ss | -uss | --shadowsocks | --update-shadowsocks)
        _update_ss=true
        shift 1
        ;;
    -usoh | --update-shadowsocks-obfs-host)
        _update_ss_obfs_host=true
        _ss_obfs_host="$2"
        shift 2
        ;;
    -stls | --shadow-tls)
        _shadow_tls=true
        shift 1
        ;;
    -ro | --remove-old-kernels)
        _remove_old_kernels=true
        shift 1
        ;;
    -rr | --reset)
        _reset=true
        shift 1
        ;;
    -rrd | --reset-with-debian)
        _reset_with_debian=true
        shift 1
        ;;
    -rru | --reset-with-ubuntu)
        _reset_with_ubuntu=true
        shift 1
        ;;
    -r | --reboot)
        _reboot=true
        shift 1
        ;;
    -s | --midea-unlock-test)
        _unlock_test=true
        shift 1
        ;;
    -st | --speedtest)
        _speedtest=true
        shift 1
        ;;
    -a | --auto)
        _auto=true
        shift 1
        ;;
    -p | --provision)
        _provision=true
        shift 1
        ;;
    -u | --username)
        username="$2"
        shift 2
        ;;
    -c | --cleanup)
        _cleanup=true
        shift 1
        ;;
    -e | --edge-kernel)
        _edge_kernel=true
        shift 1
        ;;
    -l | --lookbusy)
        _enable_lookbusy=true
        shift 1
        ;;
    -ist | --install-speedtest)
        _install_speedtest=true
        shift 1
        ;;
    -ilb | --install-lookbusy)
        _install_lookbusy=true
        shift 1
        ;;
    -ipe | --install-pyenv)
        _install_pyenv=true
        shift 1
        ;;
    -nf | --netflix-test)
        _netflix_test=true
        shift 1
        ;;
    *)
        POSITIONAL+=("$1")
        shift
        ;;
    esac
done

set -- "${POSITIONAL[@]}" # restore positional parameters

action() {
    if [ "$_update" == true ]; then
        update
    elif [ "$_upgrade" == true ]; then
        upgrade
    elif [ "$_update_ss" == true ]; then
        update_ss
    elif [ "$_update_ss_obfs_host" == true ]; then
        update_ss_obfs_host "$_ss_obfs_host"
    elif [ "$_shadow_tls" == true ]; then
        shadow_tls
    elif [ "$_self_update" == true ]; then
        self_update
    elif [ "$_remove_old_kernels" == true ]; then
        remove_old_kernels
    elif [ "$_reset" == true ] || [ "$_reset_with_debian" == true ] || [ "$_reset_with_ubuntu" == true ]; then
        [ -z "$username" ] && error "username is required when resetting system"
        system="debi"
        [ "$_reset_with_ubuntu" == true ] && system="ubuntu"
        reset $system "$username"
    elif [ "$_reboot" == true ]; then
        reboot
    elif [ "$_provision" == true ]; then
        [ -z "$username" ] && error "username is required when provisioning system"
        provision "$username"
    elif [ "$_cleanup" == true ]; then
        cleanup
    elif [ "$_install_speedtest" == true ]; then
        install_speedtest
    elif [ "$_speedtest" == true ]; then
        run_speedtest
    elif [ "$_install_lookbusy" == true ]; then
        install_lookbusy
    elif [ "$_install_pyenv" == true ]; then
        [ -z "$username" ] && error "username is required when installing pyenv"
        install_pyenv "$username"
    elif [ "$_enable_lookbusy" == true ]; then
        [ -z "$username" ] && error "username is required when enabling lookbusy"
        enable_lookbusy "$username"
    elif [ "$_unlock_test" == true ]; then
        midea_unlock_test
    elif [ "$_netflix_test" == true ]; then
        netflix_test
    elif [ "$_edge_kernel" == true ]; then
        install_edge_kernel
    elif [ "$_distro" == true ]; then
        distro
    elif [ "$_fix_grub" == true ]; then
        fix_grub
    elif [ "$_install_docker" == true ]; then
        install_docker "$username"
    elif [ "$_auto" == true ]; then
        do_all
    else
        usage
    fi
}

action
