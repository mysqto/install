function usage() {
    info "Usage: $(basename "$0") [options]"
    info "Options:"
    info "  -h    | --help                           show this help message and exit"
    info "  -4    | --ipv4                           force IPv4 for curl/wget"
    info "  -6    | --ipv6                           force IPv6 for curl/wget"
    info ""
    info "System Information & Status:"
    info "  -d    | --distro                         show the distro"
    info ""
    info "Installation & Setup:"
    info "  -ist  | --install-speedtest              install speedtest-cli"
    info "  -ilb  | --install-lookbusy               install lookbusy"
    info "  -ipe  | --install-pyenv                  install pyenv"
    info "        | --docker                         install docker"
    info "  -so   | --socat                          install socat"
    info "  -wg   | --wireguard                      install wireguard"
    info "  -wgc  | --wireguard-client client_name   install wireguard client with client_name"
    info "  -v2s  | --v2ray-server [options]         install v2ray server (all args after -v2s go to v2ray)"
    info "  -v2c  | --v2ray-client [options]         install v2ray client (all args after -v2c go to v2ray)"
    info "  -fr24 | --flightradar24 [options]        install FlightRadar24 feeder"
    info "  -ddns | --ddns [options]                 install Cloudflare DDNS"
    info "  -frp  | --frp [options]                  install FRP (server/client/gen-client)"
    info ""
    info "  V2Ray (Xray) Examples:"
    info "    im -4 -v2s --port 10086                 # server with IPv4 and custom port"
    info "    im -v2c --address 1.2.3.4 --port 443 --uuid xxx   # client (SOCKS5+HTTP proxy)"
    info "    im -v2c --tun --link 'vmess://your-link'         # TUN mode with connection link"
    info "    im -v2c -a server.com -p 443 -u xxx --tun        # TUN mode (auto-generate link)"
    info "    # Or for native VPN: im --wireguard"
    info ""
    info "  FR24 Examples:"
    info "    im -fr24 --key YOUR_KEY --email you@example.com --lat 51.5 --lon -0.1 --alt 50"
    info "    im -4 -fr24 --key YOUR_KEY --email you@example.com"
    info ""
    info "  DDNS Examples:"
    info "    im -ddns --token CF_API_TOKEN --zone-id ZONE_ID --name home.example.com"
    info "    im -ddns --token CF_API_TOKEN --zone-id ZONE_ID --name home.example.com --type AAAA"
    info "    im -ddns --token CF_API_TOKEN --zone-id ZONE_ID --name home.example.com --interval '*/10'"
    info ""
    info "  FRP Examples:"
    info "    im -frp                                                          # install frps (defaults: port 7000, auto token)"
    info "    im -frp --bind-port 7000 --dashboard-port 7500                   # frps with dashboard"
    info "    im -frp --client user@frp-server.com --proxy ssh:tcp::22:6022    # install frpc on this NAT'd box"
    info "    im -frp --gen-client /tmp/frpc.toml --proxy ssh:tcp::22:6022     # on server: emit frpc.toml to copy out"
    info "System Updates & Maintenance:"
    info "  -uu   | --update                         update the server"
    info "  -uuu  | --upgrade                        upgrade the server if needed"
    info "  -ui   | --self-update                    update $(basename "$0")"
    info "  -ro   | --remove-old-kernels             remove old kernels"
    info "  -c    | --cleanup                        cleanup the server"
    info "  -a    | --auto                           auto update or upgrade the server"
    info "  -f    | --fix-grub                       fix grub boot menu"
    info "        | --netplan                        convert /etc/network/interfaces to netplan"
    info "  -e    | --edge-kernel                    install edge kernel"
    info ""
    info "Shadowsocks & Network Tools:"
    info "  -ss   | --shadowsocks                    install shadowsocks-rust"
    info "  -uss  | --update-shadowsocks             update shadowsocks-libev or shadowsocks-rust"
    info "  -usoh | --update-shadowsocks-obfs-host   update shadowsocks-libev or shadowsocks-rust obfs host"
    info "  -stls | --shadow-tls [options]           enable snell and shadow-tls (all args after -stls are forwarded)"
    info ""
    info "Testing & Monitoring:"
    info "  -st   | --speedtest                      run speedtest"
    info "  -l    | --lookbusy                       enable lookbusy"
    info "  -s    | --midea-unlock-test              stream media unlock test"
    info "  -nf   | --netflix-test                   netflix unlock test"
    info ""
    info "System Management:"
    info "  -rr   | --reset                          reset the server, need -u to specify the username"
    info "  -rrd  | --reset-with-debian              reset the server with debian, need -u to specify the username"
    info "  -rru  | --reset-with-ubuntu              reset the server with ubuntu, need -u to specify the username"
    info "  -r    | --reboot                         reboot the server"
    info "  -p    | --provision                      provision the server, need -u to specify the username"
    info "  -hn   | --hostname <name>                set the system hostname"
    info ""
    info "User Options:"
    info "  -u    | --username                      specify the username when reseting or provisioning the server"
}

POSITIONAL=()

while [ $# -gt 0 ]; do
    case "$1" in
        -h | --help)
            usage
            exit 0
            ;;
        -4 | --ipv4)
            CURL_OPTS="-4"
            WGET_OPTS="-4"
            shift 1
            ;;
        -6 | --ipv6)
            CURL_OPTS="-6"
            WGET_OPTS="-6"
            shift 1
            ;;
        -d | --distro)
            _distro=true
            shift 1
            ;;
        --docker)
            _install_docker=true
            shift 1
            ;;
        -f | --fix-grub)
            _fix_grub=true
            shift 1
            ;;
        -uu | --update)
            _update=true
            shift 1
            ;;
        -uuu | --ugrade)
            _upgrade=true
            shift 1
            ;;
        -ui | --self-update)
            _self_update=true
            shift 1
            ;;
        -ss | --shadowsocks)
            _shadowsocks=true
            shift 1
            ;;
        -uss | --update-shadowsocks)
            _update_ss=true
            shift 1
            ;;
        -usoh | --update-shadowsocks-obfs-host)
            _update_ss_obfs_host=true
            _ss_obfs_host="$2"
            shift 2
            ;;
        -stls | --shadow-tls)
            _shadow_tls=true
            shift
            # Collect all remaining arguments for shadow-tls
            while [[ $# -gt 0 ]]; do
                shadow_tls_args+=("$1")
                shift
            done
            ;;
        -ro | --remove-old-kernels)
            _remove_old_kernels=true
            shift 1
            ;;
        -rr | --reset)
            _reset=true
            shift 1
            ;;
        -rrd | --reset-with-debian)
            _reset_with_debian=true
            shift 1
            ;;
        -rru | --reset-with-ubuntu)
            _reset_with_ubuntu=true
            shift 1
            ;;
        -r | --reboot)
            _reboot=true
            shift 1
            ;;
        -s | --midea-unlock-test)
            _unlock_test=true
            shift 1
            ;;
        -st | --speedtest)
            _speedtest=true
            shift 1
            ;;
        -a | --auto)
            _auto=true
            shift 1
            ;;
        -p | --provision)
            _provision=true
            shift 1
            ;;
        -u | --username)
            username="$2"
            shift 2
            ;;
        -c | --cleanup)
            _cleanup=true
            shift 1
            ;;
        -e | --edge-kernel)
            _edge_kernel=true
            shift 1
            ;;
        -l | --lookbusy)
            _enable_lookbusy=true
            shift 1
            ;;
        -ist | --install-speedtest)
            _install_speedtest=true
            shift 1
            ;;
        -ilb | --install-lookbusy)
            _install_lookbusy=true
            shift 1
            ;;
        -ipe | --install-pyenv)
            _install_pyenv=true
            shift 1
            ;;
        -nf | --netflix-test)
            _netflix_test=true
            shift 1
            ;;
        --netplan)
            _convert_netplan=true
            shift
            ;;
        -so | --socat)
            _install_socat=true
            shift
            ;;
        -wg | --wireguard)
            _install_wireguard=true
            shift
            ;;
        -wgc | --wireguard-client)
            wg_client=$2
            shift 2
            ;;
        -v2s | --v2ray-server)
            _install_v2ray=true
            v2ray_mode="--server"
            shift
            # Collect all remaining arguments for v2ray
            while [[ $# -gt 0 ]]; do
                v2ray_args+=("$1")
                shift
            done
            ;;
        -v2c | --v2ray-client)
            _install_v2ray=true
            v2ray_mode="--client"
            shift
            # Collect all remaining arguments for v2ray
            while [[ $# -gt 0 ]]; do
                v2ray_args+=("$1")
                shift
            done
            ;;
        -fr24 | --flightradar24)
            _install_fr24=true
            shift
            # Collect all remaining arguments for fr24
            while [[ $# -gt 0 ]]; do
                fr24_args+=("$1")
                shift
            done
            ;;
        -ddns | --ddns)
            _install_ddns=true
            shift
            # Collect all remaining arguments for ddns
            while [[ $# -gt 0 ]]; do
                ddns_args+=("$1")
                shift
            done
            ;;
        -frp | --frp)
            _install_frp=true
            shift
            # Collect all remaining arguments for frp
            while [[ $# -gt 0 ]]; do
                frp_args+=("$1")
                shift
            done
            ;;
        -hn | --hostname)
            _set_hostname=true
            _hostname_value="$2"
            shift 2
            ;;
        *)
            POSITIONAL+=("$1")
            warn "unknown option $1"
            shift
            ;;
    esac
done

set -- "${POSITIONAL[@]}" # restore positional parameters

# Show IP version if forced
[ -n "$CURL_OPTS" ] && info "Forcing IP version: $CURL_OPTS for network connections"

# Export for use in child scripts
export CURL_OPTS
export WGET_OPTS

action() {
    if [ "$_update" == true ]; then
        update
    elif [ "$_upgrade" == true ]; then
        upgrade
    elif [ "$_shadowsocks" == true ]; then
        shadowsocks
    elif [ "$_update_ss" == true ]; then
        update_ss
    elif [ "$_update_ss_obfs_host" == true ]; then
        update_ss_obfs_host "$_ss_obfs_host"
    elif [ "$_shadow_tls" == true ]; then
        shadow_tls "${shadow_tls_args[@]}"
    elif [ "$_self_update" == true ]; then
        self_update
    elif [ "$_remove_old_kernels" == true ]; then
        remove_old_kernels
    elif [ "$_reset" == true ] || [ "$_reset_with_debian" == true ] || [ "$_reset_with_ubuntu" == true ]; then
        [ -z "$username" ] && error "username is required when resetting system"
        system="debi"
        [ "$_reset_with_ubuntu" == true ] && system="ubuntu"
        reset $system "$username"
    elif [ "$_reboot" == true ]; then
        reboot
    elif [ "$_provision" == true ]; then
        [ -z "$username" ] && error "username is required when provisioning system"
        provision "$username"
    elif [ "$_cleanup" == true ]; then
        cleanup
    elif [ "$_install_speedtest" == true ]; then
        install_speedtest
    elif [ "$_speedtest" == true ]; then
        run_speedtest
    elif [ "$_install_lookbusy" == true ]; then
        install_lookbusy
    elif [ "$_install_pyenv" == true ]; then
        [ -z "$username" ] && error "username is required when installing pyenv"
        install_pyenv "$username"
    elif [ "$_enable_lookbusy" == true ]; then
        [ -z "$username" ] && error "username is required when enabling lookbusy"
        enable_lookbusy "$username"
    elif [ "$_unlock_test" == true ]; then
        midea_unlock_test
    elif [ "$_netflix_test" == true ]; then
        netflix_test
    elif [ "$_edge_kernel" == true ]; then
        install_edge_kernel
    elif [ "$_distro" == true ]; then
        distro
    elif [ "$_fix_grub" == true ]; then
        fix_grub
    elif [ "$_convert_netplan" == true ]; then
        convert_to_netplan
    elif [ "$_install_docker" == true ]; then
        install_docker "$username"
    elif [ "$_install_socat" == true ]; then
        install_socat
    elif [ "$_install_wireguard" == true ]; then
        install_wireguard "wg0" $wg_client
    elif [ "$_install_v2ray" == true ]; then
        install_v2ray "$v2ray_mode" "${v2ray_args[@]}"
    elif [ "$_install_fr24" == true ]; then
        install_fr24 "${fr24_args[@]}"
    elif [ "$_install_ddns" == true ]; then
        install_ddns "${ddns_args[@]}"
    elif [ "$_install_frp" == true ]; then
        install_frp "${frp_args[@]}"
    elif [ "$_set_hostname" == true ]; then
        set_hostname "$_hostname_value"
    elif [ "$_auto" == true ]; then
        do_all
    else
        usage
    fi
}

action
