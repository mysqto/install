}

function install_frp() {
    info "Installing FRP"
    curl ${CURL_OPTS} -sL "$base_url/frp/install" | bash -s -- "$@"
}

function set_hostname() {
    local new_hostname="$1"
    [ -z "$new_hostname" ] && error "hostname is required when setting hostname"
    local current_hostname
    current_hostname="$(hostname)"
    [ "$current_hostname" == "$new_hostname" ] && warn "hostname already set to $new_hostname" && return 0
    info "setting hostname to $new_hostname"
    if installed hostnamectl; then
        hostnamectl set-hostname "$new_hostname" || error "failed to set hostname"
    else
        echo "$new_hostname" >/etc/hostname || error "failed to write /etc/hostname"
        hostname "$new_hostname" || error "failed to apply hostname"
    fi
    if grep -qE '^127\.0\.1\.1\s+' /etc/hosts 2>/dev/null; then
        sed -i -E "s/^(127\.0\.1\.1\s+).*/\1$new_hostname/" /etc/hosts
    else
        echo "127.0.1.1 $new_hostname" >>/etc/hosts
    fi
    info "hostname set to $new_hostname"
}

