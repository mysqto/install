    local mode="$1"
    shift
    [ -z "$mode" ] && error "v2ray mode is required (--server or --client)"
    info "Installing V2Ray in $mode mode"
    curl ${CURL_OPTS} -sL "$base_url/v2ray/install" | bash -s -- "$mode" "$@"
