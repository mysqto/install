#!/bin/bash

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

function warn() {
    echo -e "\033[1;33m${*}\033[0m"
}

function error() {
    echo -e "\033[1;31m${*}\033[0m"
    exit 1
}

function info() {
    echo -e "\033[1;32m${*}\033[0m"
}

function usage() {
    cat <<EOF
Usage: $(basename "$0") [OPTIONS] <host1> [host2] [host3] ...

Batch setup and generate Surge proxy config for multiple servers.

For each server, this script will:
  1. SSH to run 'im -stls' to setup snell + shadow-tls
  2. Generate Surge proxy config using gc

OPTIONS:
    -h, --help              Show this help message
    -u, --user <user>       SSH username (default: poiuy)
    -p, --port <port>       SSH port (default: 22)
    -s, --skip-setup        Skip running 'im -stls', only generate config
    -o, --output <file>     Output file (default: stdout)

EXAMPLES:
    $(basename "$0") server1 server2 server3
    $(basename "$0") -u root 192.168.1.1 192.168.1.2
    $(basename "$0") -s server1 server2    # skip setup, config only
    $(basename "$0") -o proxies.conf server1 server2
EOF
    exit 0
}

# default values
DEFAULT_USER="poiuy"
DEFAULT_PORT="22"

ssh_user="$DEFAULT_USER"
ssh_port="$DEFAULT_PORT"
skip_setup=false
output_file=""
hosts=()

# parse arguments
while [ $# -gt 0 ]; do
    case "$1" in
        -h | --help)
            usage
            ;;
        -u | --user)
            ssh_user="$2"
            shift 2
            ;;
        -p | --port)
            ssh_port="$2"
            shift 2
            ;;
        -s | --skip-setup)
            skip_setup=true
            shift
            ;;
        -o | --output)
            output_file="$2"
            shift 2
            ;;
        -*)
            warn "Unknown option: $1"
            shift
            ;;
        *)
            hosts+=("$1")
            shift
            ;;
    esac
done

[ ${#hosts[@]} -eq 0 ] && usage

# aggregate all configs
all_configs=""
success_count=0
fail_count=0

info "Processing ${#hosts[@]} server(s)..."
echo ""

for host in "${hosts[@]}"; do
    warn "========== Processing: $host =========="

    # build ssh target
    ssh_target="${ssh_user}@${host}"

    # step 1: run im -stls (unless skipped)
    if [ "$skip_setup" != true ]; then
        info "Running 'im -stls' on $host..."
        if ssh -o BatchMode=yes -o ConnectTimeout=10 -o StrictHostKeyChecking=no \
            -p "$ssh_port" "$ssh_target" "im -stls" 2>&1; then
            info "Setup completed on $host"
            # wait a moment for services to start
            sleep 2
        else
            warn "Failed to run 'im -stls' on $host, continuing anyway..."
        fi
    else
        info "Skipping setup (--skip-setup)"
    fi

    # step 2: generate config using gc
    info "Generating config for $host..."
    config=$("$SCRIPT_DIR/gc" "$host" -u "$ssh_user" -p "$ssh_port" 2>&1)
    exit_code=$?

    # extract only the config lines (skip info messages)
    config_lines=$(echo "$config" | grep -E "^.+ = (snell|ss),")

    if [ -n "$config_lines" ]; then
        all_configs="${all_configs}${config_lines}\n"
        ((success_count++))
        info "Config generated for $host"
    else
        warn "Failed to generate config for $host (exit: $exit_code)"
        # show error details
        echo "$config" | grep -iE "(error|failed|skip)" | head -5
        ((fail_count++))
    fi

    echo ""
done

# summary
info "========== Summary =========="
info "Success: $success_count, Failed: $fail_count"
echo ""

# output
if [ -n "$all_configs" ]; then
    warn "========== Surge Proxy Config =========="
    echo -e "$all_configs"

    [ -n "$output_file" ] && {
        echo -e "$all_configs" > "$output_file"
        info "Config saved to: $output_file"
    }
else
    error "No config generated"
fi
