#!/bin/bash

function warn() {
    echo -e "\033[1;33m${*}\033[0m"
}

function error() {
    echo -e "\033[1;31m${*}\033[0m"
    exit 1
}

function info() {
    echo -e "\033[1;32m${*}\033[0m"
}

function installed() {
    command -v "$1" >/dev/null 2>&1
}

function usage() {
    cat <<EOF
Usage: $(basename "$0") [OPTIONS] [hostname]

Generate Surge proxy config from remote server.
If no hostname is provided, process all hosts from ~/.ssh/config.

OPTIONS:
    -h, --help              Show this help message
    -u, --user <user>       SSH username
    -p, --port <port>       SSH port
    -P, --password <pass>   SSH password (not recommended, use key instead)
    -i, --identity <file>   SSH private key file
    -o, --output <file>     Output file (default: stdout)
    -a, --all               Process all hosts from SSH config

EXAMPLES:
    $(basename "$0")                              # Process all SSH hosts
    $(basename "$0") my-server                    # Process single host
    $(basename "$0") -u root -p 22 192.168.1.1
    $(basename "$0") -i ~/.ssh/id_rsa user@host
EOF
    exit 0
}

# check if host is a wildcard/regex pattern
function is_wildcard_host() {
    local host="$1"
    [[ "$host" == *"*"* ]] && return 0
    [[ "$host" == *"?"* ]] && return 0
    [[ "$host" == *"!"* ]] && return 0
    return 1
}

# check if host should be skipped (local, git, or special hosts)
function should_skip_host() {
    local host="$1"
    # localhost variants
    [[ "$host" == "localhost" ]] && return 0
    [[ "$host" == "127."* ]] && return 0
    [[ "$host" == "::1" ]] && return 0
    # private IP ranges
    [[ "$host" == "10."* ]] && return 0
    [[ "$host" == "172.16."* ]] && return 0
    [[ "$host" == "172.17."* ]] && return 0
    [[ "$host" == "172.18."* ]] && return 0
    [[ "$host" == "172.19."* ]] && return 0
    [[ "$host" == "172.2"[0-9]"."* ]] && return 0
    [[ "$host" == "172.30."* ]] && return 0
    [[ "$host" == "172.31."* ]] && return 0
    [[ "$host" == "192.168."* ]] && return 0
    # link-local
    [[ "$host" == "169.254."* ]] && return 0
    # orbstack local containers
    [[ "$host" == "orb" ]] && return 0
    # git hosts
    [[ "$host" == "github" ]] && return 0
    [[ "$host" == "github.com" ]] && return 0
    [[ "$host" == "bitbucket" ]] && return 0
    [[ "$host" == "bitbucket.org" ]] && return 0
    [[ "$host" == "gitlab" ]] && return 0
    [[ "$host" == "gitlab.com" ]] && return 0
    # local machines (common patterns)
    [[ "$host" == *"iMac"* ]] && return 0
    [[ "$host" == *"MacBook"* ]] && return 0
    [[ "$host" == *".local" ]] && return 0
    return 1
}

# alias for backward compatibility
function is_local_host() {
    should_skip_host "$1"
}

# get all ssh config files (including includes)
function get_ssh_config_files() {
    local config_dir="$HOME/.ssh"
    local main_config="$config_dir/config"
    local files=()

    [ ! -f "$main_config" ] && return

    files+=("$main_config")

    # parse Include directives
    while IFS= read -r line; do
        [[ "$line" =~ ^[[:space:]]*[Ii]nclude[[:space:]]+ ]] || continue
        local pattern="${line#*[Ii]nclude}"
        pattern="${pattern#"${pattern%%[![:space:]]*}"}"
        pattern="${pattern/#\~/$HOME}"
        # handle relative paths
        [[ "$pattern" != /* ]] && pattern="$config_dir/$pattern"
        # skip orbstack and other container/VM tool configs
        [[ "$pattern" == *"orbstack"* ]] && continue
        [[ "$pattern" == *"multipass"* ]] && continue
        [[ "$pattern" == *"lima"* ]] && continue
        # expand glob
        shopt -s nullglob
        for f in $pattern; do
            [ -f "$f" ] && files+=("$f")
        done
    done <"$main_config"

    printf '%s\n' "${files[@]}"
}

# get all valid hosts from ssh config
function get_all_ssh_hosts() {
    local hosts=()
    local config_files=()

    # get config files first (with glob expansion enabled)
    while IFS= read -r f; do
        [ -n "$f" ] && config_files+=("$f")
    done < <(get_ssh_config_files)

    for config_file in "${config_files[@]}"; do
        [ -z "$config_file" ] && continue
        [ ! -f "$config_file" ] && continue

        while IFS= read -r line; do
            # match Host directive (not Match)
            [[ "$line" =~ ^[[:space:]]*[Hh]ost[[:space:]]+ ]] || continue
            [[ "$line" =~ ^[[:space:]]*[Hh]ost[Nn]ame ]] && continue

            local host_list="${line#*[Hh]ost}"
            host_list="${host_list#"${host_list%%[![:space:]]*}"}"

            # split by whitespace using read to avoid glob expansion
            local host_array
            IFS=' ' read -ra host_array <<< "$host_list"
            for host in "${host_array[@]}"; do
                [ -z "$host" ] && continue
                # skip wildcards
                is_wildcard_host "$host" && continue
                # skip local hosts
                is_local_host "$host" && continue
                # skip if already in list
                local exists=false
                for h in "${hosts[@]}"; do
                    [ "$h" = "$host" ] && exists=true && break
                done
                [ "$exists" = true ] && continue
                hosts+=("$host")
            done
        done <"$config_file"
    done

    printf '%s\n' "${hosts[@]}"
}

