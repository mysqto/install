# ss2any environment file. Copy to .ss2any.env and edit.
#
# REQUIRED: upstream proxy link (any one supported scheme).
# Supported schemes:
#   vless://     trojan://     vmess://     ss://     hy2:// / hysteria2://     tuic://
#
# Examples (do NOT use these literally — replace with your own):
#   PROXY_LINK=vless://UUID@example.com:443?security=reality&pbk=PUBKEY&sid=SHORTID&sni=example.com&fp=chrome&flow=xtls-rprx-vision#node-name
#   PROXY_LINK=trojan://password@example.com:443?security=tls&sni=example.com&type=ws&path=/ws&host=example.com#node-name
#   PROXY_LINK=vmess://eyJ2IjoiMiIsInBzIjoibm9kZSIsImFkZCI6ImV4YW1wbGUuY29tIiwicG9ydCI6IjQ0MyIsInR5cGUiOiJub25lIiwiaWQiOiJVVUlEIiwiYWlkIjoiMCIsInNjeSI6ImF1dG8iLCJuZXQiOiJ3cyIsInBhdGgiOiIvIiwidGxzIjoidGxzIn0=
PROXY_LINK=

# Shadowsocks inbound — what clients connect to. All optional.
# SS_PORT=8388
# SS_METHOD=chacha20-ietf-poly1305
# SS_PASSWORD=                      # auto-generated if blank (logged once at startup)
# SS_NETWORK=tcp                    # tcp | udp | tcp_and_udp  (UDP requires upstream UDP support)

# LOG_LEVEL=info                    # trace | debug | info | warn | error | fatal | panic
