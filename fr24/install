#!/usr/bin/env bash

# Check root privileges
[ $EUID -ne 0 ] && echo "Error: This script must be run as root!" && exit 1

# Default values
prefix="/usr/local"
sharing_key=""
latitude=""
longitude=""
altitude=""
receiver="dvbt"

# Use CURL_OPTS and WGET_OPTS from environment if set
[ -z "$CURL_OPTS" ] && CURL_OPTS=""
[ -z "$WGET_OPTS" ] && WGET_OPTS=""

# Configuration (will be set after prefix is parsed)
fr24_bin=""
fr24_config_dir=""
fr24_config_file=""
fr24_service_file="/etc/systemd/system/fr24feed.service"
fr24_download_base="https://repo-feed.flightradar24.com"
fr24_version="1.0.54-0"  # Default version, will try to get latest

function info() {
    echo -e "\033[1;32m${*}\033[0m"
}

function warn() {
    echo -e "\033[1;33m${*}\033[0m"
}

function error() {
    echo -e "\033[1;31m${*}\033[0m"
    exit 1
}

function installed() {
    command -v "$1" >/dev/null 2>&1
}

function detect_arch() {
    case $(uname -m) in
        x86_64) echo "amd64" ;;
        i386 | i686) echo "i386" ;;
        armv7l) echo "armhf" ;;
        aarch64 | arm64) echo "arm64" ;;
        *) error "Unsupported architecture: $(uname -m)" ;;
    esac
}

function get_binary_dir() {
    local arch="$1"
    # FR24 uses different directories for different architectures
    case "$arch" in
        arm64|armhf) echo "rpi_binaries" ;;
        amd64|i386) echo "linux_x86_binaries" ;;
        *) echo "linux_x86_binaries" ;;
    esac
}

function download() {
    local url="$1"
    local target="$2"
    [ -z "$target" ] && target="$(basename "$url")"
    local target_dir="$(dirname "$target")"
    [ ! -d "$target_dir" ] && mkdir -p "$target_dir"
    [ -f "$target" ] && rm -rf "$target"
    info "Downloading $url to $target"
    curl ${CURL_OPTS} --progress-bar -Lo "$target" "$url"
}

function download_fr24feed() {
    local arch="$(detect_arch)"
    local binary_dir="$(get_binary_dir "$arch")"
    local download_file="fr24feed_${fr24_version}_${arch}.tgz"
    local download_url="${fr24_download_base}/${binary_dir}/${download_file}"
    
    info "Downloading FR24Feed for $arch from $binary_dir"
    
    # Ensure directories exist
    [ ! -d "$(dirname "$fr24_bin")" ] && mkdir -p "$(dirname "$fr24_bin")"
    
    # Check installed version
    if [ -f "$fr24_bin" ]; then
        installed_version="$($fr24_bin --version 2>/dev/null | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1 || echo '')"
        if [ -n "$installed_version" ]; then
            info "FR24Feed already installed: $installed_version"
        fi
    fi
    
    local wd=$(mktemp -d)
    pushd "$wd" >/dev/null 2>&1 || exit
    
    download "$download_url" "$download_file" || error "Failed to download FR24Feed from $download_url"
    
    # Install tar if not available
    if ! installed tar; then
        if installed apt || installed apt-get; then
            apt update && DEBIAN_FRONTEND=noninteractive apt install -y tar
        elif installed yum; then
            yum install -y tar
        elif installed pacman; then
            pacman -Sy --noconfirm tar
        fi
    fi
    
    tar -xzf "$download_file" || error "Failed to extract FR24Feed"
    
    # Find and install the binary
    if [ -f "fr24feed" ]; then
        mv fr24feed "$fr24_bin"
    elif [ -f "fr24feed_${arch}/fr24feed" ]; then
        mv "fr24feed_${arch}/fr24feed" "$fr24_bin"
    else
        error "Failed to find FR24Feed binary in archive"
    fi
    
    [ ! -f "$fr24_bin" ] && error "Failed to install FR24Feed binary"
    chmod +x "$fr24_bin"
    
    popd >/dev/null 2>&1 || exit
    rm -rf "$wd"
    
    installed_version="$($fr24_bin --version 2>/dev/null | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1 || echo '')"
    info "FR24Feed installed successfully: ${installed_version:-unknown}"
    info "Installation prefix: $prefix"
}

function create_config() {
    [ ! -d "$fr24_config_dir" ] && mkdir -p "$fr24_config_dir"
    
    # Generate random sharing key if not provided
    if [ -z "$sharing_key" ] && [ -f "$fr24_config_file" ]; then
        sharing_key=$(grep -oE 'fr24key="[^"]+"' "$fr24_config_file" | cut -d'"' -f2)
    fi
    
    cat > "$fr24_config_file" <<EOF
# FlightRadar24 Feeder Configuration
# Generated by install script

receiver="$receiver"
fr24key="$sharing_key"
host="127.0.0.1:30005"
bs="yes"
raw="yes"
logmode="1"
logpath="/var/log/fr24feed"
mlat="yes"
mlat-without-gps="yes"
EOF

    # Add location if provided
    if [ -n "$latitude" ] && [ -n "$longitude" ]; then
        cat >> "$fr24_config_file" <<EOF
latitude="$latitude"
longitude="$longitude"
EOF
    fi
    
    if [ -n "$altitude" ]; then
        echo "altitude=\"$altitude\"" >> "$fr24_config_file"
    fi
    
    chmod 644 "$fr24_config_file"
    info "Configuration created: $fr24_config_file"
    
    if [ -z "$sharing_key" ]; then
        warn "No sharing key provided!"
        warn "Sign up at: https://www.flightradar24.com/share-your-data"
        warn "Then run: $fr24_bin --signup"
        warn "Or update config: $fr24_config_file"
    fi
}

function create_systemd_service() {
    # Check if systemctl is available
    if ! installed systemctl; then
        warn "systemctl not found, skipping systemd service creation"
        info "To run FR24Feed manually: $fr24_bin --config-file=$fr24_config_file"
        return 0
    fi
    
    cat > "$fr24_service_file" <<EOF
[Unit]
Description=FlightRadar24 Feeder
Documentation=https://www.flightradar24.com
After=network.target

[Service]
Type=simple
User=root
ExecStart=$fr24_bin --config-file=$fr24_config_file
Restart=on-failure
RestartSec=3
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
EOF
    
    systemctl daemon-reload
    systemctl enable fr24feed
    info "FR24Feed service created and enabled"
}

function start_service() {
    # Check if systemctl is available
    if ! installed systemctl; then
        warn "systemctl not found, skipping service start"
        info "FR24Feed installation completed. Start manually with:"
        info "  $fr24_bin --config-file=$fr24_config_file"
        return 0
    fi
    
    if systemctl is-active --quiet fr24feed; then
        info "Restarting FR24Feed service..."
        systemctl restart fr24feed
    else
        info "Starting FR24Feed service..."
        systemctl start fr24feed
    fi
    
    sleep 1
    if systemctl is-active --quiet fr24feed; then
        info "FR24Feed service is running"
    else
        warn "Failed to start FR24Feed service. Check: journalctl -u fr24feed -n 50"
        info "You can start it manually with: systemctl start fr24feed"
    fi
}

function display_config() {
    info "======================================================================"
    info "FlightRadar24 Feeder Configuration:"
    info "  Installation prefix: $prefix"
    info "  Binary: $fr24_bin"
    info "  Config: $fr24_config_file"
    info "  Receiver type: $receiver"
    
    if [ -n "$sharing_key" ]; then
        info "  Sharing key: $sharing_key"
    else
        warn "  Sharing key: NOT SET - run signup!"
    fi
    
    if [ -n "$latitude" ] && [ -n "$longitude" ]; then
        info "  Location: $latitude, $longitude"
        [ -n "$altitude" ] && info "  Altitude: ${altitude}m"
    else
        warn "  Location: NOT SET"
    fi
    
    info ""
    info "Next steps:"
    if [ -z "$sharing_key" ]; then
        info "  1. Sign up: https://www.flightradar24.com/share-your-data"
        info "  2. Run signup: $fr24_bin --signup"
        info "  3. Update config: $fr24_config_file"
        info "  4. Restart service: systemctl restart fr24feed"
    else
        info "  1. Check status: systemctl status fr24feed"
        info "  2. View stats: $fr24_bin --monitor"
        info "  3. View logs: journalctl -u fr24feed -f"
    fi
    info "======================================================================"
}

function usage() {
    cat <<EOF
Usage: $(basename "$0") [OPTIONS]

Install and configure FlightRadar24 feeder

OPTIONS:
  -k, --key KEY             Sharing/FR24 key (required for feeding)
  --lat LATITUDE            Receiver latitude
  --lon LONGITUDE           Receiver longitude
  --alt ALTITUDE            Receiver altitude in meters
  -r, --receiver TYPE       Receiver type (default: dvbt)
                            Options: dvbt, beast, radarcape, avr, sbs
  -v, --version VERSION     FR24Feed version (default: 1.0.54-0)
  --prefix PATH             Installation prefix (default: /usr/local)
  -4, --ipv4                Force IPv4 for downloads
  -6, --ipv6                Force IPv6 for downloads
  -h, --help                Show this help message

EXAMPLES:
  # Install with sharing key and location
  $(basename "$0") --key YOUR_KEY --lat 51.5074 --lon -0.1278 --alt 50

  # Install with custom prefix
  $(basename "$0") --prefix /opt/fr24 --key YOUR_KEY

  # Install and run signup later
  $(basename "$0")

  # Install with forced IPv4
  $(basename "$0") --key YOUR_KEY -4

For more info: https://www.flightradar24.com/share-your-data

EOF
}

# Parse arguments
POSITIONAL=()
while [ $# -gt 0 ]; do
    case $1 in
        -h|--help)
            usage
            exit 0
            ;;
        -k|--key)
            sharing_key="$2"
            shift 2
            ;;
        --lat|--latitude)
            latitude="$2"
            shift 2
            ;;
        --lon|--longitude)
            longitude="$2"
            shift 2
            ;;
        --alt|--altitude)
            altitude="$2"
            shift 2
            ;;
        -r|--receiver)
            receiver="$2"
            shift 2
            ;;
        -v|--version)
            fr24_version="$2"
            shift 2
            ;;
        --prefix)
            prefix="$2"
            shift 2
            ;;
        -4|--ipv4)
            CURL_OPTS="-4"
            WGET_OPTS="-4"
            shift
            ;;
        -6|--ipv6)
            CURL_OPTS="-6"
            WGET_OPTS="-6"
            shift
            ;;
        *)
            POSITIONAL+=("$1")
            shift
            ;;
    esac
done

set -- "${POSITIONAL[@]}"

# Set paths based on prefix
fr24_bin="$prefix/bin/fr24feed"
fr24_config_dir="$prefix/etc/fr24feed"
fr24_config_file="$fr24_config_dir/fr24feed.ini"

# Install dependencies
if installed apt || installed apt-get; then
    apt update
    DEBIAN_FRONTEND=noninteractive apt install -y curl tar
elif installed yum; then
    yum install -y curl tar
elif installed pacman; then
    pacman -Sy --noconfirm curl tar
fi

# Main installation
info "Installing FlightRadar24 Feeder..."
download_fr24feed
create_config
create_systemd_service
start_service
display_config

info ""
info "Installation completed successfully!"
info "Installation prefix: $prefix"
info "Binary location: $fr24_bin"
info "Config file: $fr24_config_file"

if installed systemctl; then
    info "Service status: systemctl status fr24feed"
    info "View logs: journalctl -u fr24feed -f"
else
    info "Start FR24Feed: $fr24_bin --config-file=$fr24_config_file"
fi

