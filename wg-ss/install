#!/bin/bash
# wg-ss installer — Docker setup for a WireGuard client peer + Shadowsocks entry
# point. Meant to be curl-piped from im:
#
#   curl -sL https://debian.lol/wg-ss/install | bash -s -- --conf /root/wg0.conf --ss-port 8388
#
# Unlike the systemd installers in this repo, this one is Docker-based: it
# fetches the Dockerfile + entrypoint from base_url, builds the image, and runs
# the container. Docker is installed (as root) only if missing; the image build
# and container run happen as the INVOKING user (the docker-group member),
# never as root — so the container is owned by that user.
set -euo pipefail

function info()  { echo -e "\033[1;32m${*}\033[0m"; }
function warn()  { echo -e "\033[1;33m${*}\033[0m" >&2; }
function error() { echo -e "\033[1;31m${*}\033[0m" >&2; exit 1; }
function installed() { command -v "$1" >/dev/null 2>&1; }

[ -z "${CURL_OPTS:-}" ] && CURL_OPTS=""

# ---------------------------------------------------------------------------
# base_url resolution (debian.lol, github raw fallback) — mirrors im.
# ---------------------------------------------------------------------------
base_url="https://debian.lol"
github_base="https://raw.githubusercontent.com/mysqto/install/gh-pages"
if ! curl ${CURL_OPTS} -sL --connect-timeout 5 "$base_url" >/dev/null 2>&1; then
    warn "Failed to connect to $base_url, trying $github_base"
    base_url="$github_base"
    curl ${CURL_OPTS} -sL --connect-timeout 5 "$base_url" >/dev/null 2>&1 \
        || error "Failed to connect to $base_url"
fi

# ---------------------------------------------------------------------------
# Who runs docker? The invoking (non-root) user, via the docker group.
# When called through im (already root) SUDO_USER holds the original user.
# ---------------------------------------------------------------------------
target_user="${SUDO_USER:-$(id -un)}"
[ "$target_user" = "root" ] && target_user=""   # logged in as root directly: no drop-down possible

as_user() {
    if [ -n "$target_user" ] && [ "$(id -u)" -eq 0 ]; then
        sudo -u "$target_user" "$@"
    else
        "$@"
    fi
}

image="wg-ss"
container="wg-ss"
state_volume="wg-ss-state"

conf_file=""
private_key="${WG_PRIVATE_KEY:-}"
address=""
peer_key=""
endpoint=""
psk="${WG_PRESHARED_KEY:-}"
allowed_ips=""
dns=""
no_dns=""
mtu=""
keepalive=""
table=""
probe_target=""
no_probe=""
ss_port=""
ss_password="${SS_PASSWORD:-}"
obfs_host=""
bind_ip="0.0.0.0"
env_file=""
force_build=""

usage() {
    cat <<EOF
Usage: wg-ss/install [options]

Tunnel options (one config source is required on first run):
  --conf <file>        A WireGuard .conf to use as-is (mounted read-only)
  --private-key <key>  Client private key (or WG_PRIVATE_KEY)
  --address <cidr>     This peer's tunnel address, e.g. 10.0.0.2/32
  --peer-key <key>     Server's public key
  --endpoint <h:port>  Server endpoint, e.g. vpn.example.com:51820
  --psk <key>          Pre-shared key (optional)
  --allowed-ips <c>    What to route into the tunnel (default 0.0.0.0/0,::/0)
  --dns <servers>      Resolver inside the container (comma-separated)
  --no-dns             Ignore tunnel DNS; keep docker's resolver
  --mtu <n>            Tunnel MTU (default 1420)
  --keepalive <n>      PersistentKeepalive seconds (default 25)
  --table <name|off>   wg-quick routing table, or 'off' to manage it yourself

Liveness probe:
  --probe-target <ip>  Ping this through the tunnel to detect a dead peer
  --no-probe           Disable probing entirely

Shadowsocks options:
  --ss-port <port>     SS server port (default 8388)
  --ss-password <pw>   SS password (auto-generated + logged if omitted)
  --obfs-host <host>   obfs masquerade host (client-side hint)

Runtime options:
  --bind <ip>          Host bind for the published SS port (default 0.0.0.0)
  --env-file <file>    KEY=VALUE file (WG_*, SS_*) passed to the container
  --name <name>        Container name (default: $container)
  --state-volume <v>   Volume for /etc/wireguard (default: $state_volume)
  --build, --rebuild   Force image rebuild (otherwise a cached image is reused)
  --help               Show this help
EOF
    exit 1
}

while [ $# -gt 0 ]; do
    case "$1" in
        --conf|--config)   shift; conf_file="${1:-}"; shift ;;
        --private-key)     shift; private_key="${1:-}"; shift ;;
        --address)         shift; address="${1:-}"; shift ;;
        --peer-key)        shift; peer_key="${1:-}"; shift ;;
        --endpoint)        shift; endpoint="${1:-}"; shift ;;
        --psk)             shift; psk="${1:-}"; shift ;;
        --allowed-ips)     shift; allowed_ips="${1:-}"; shift ;;
        --dns)             shift; dns="${1:-}"; shift ;;
        --no-dns)          no_dns="1"; shift ;;
        --mtu)             shift; mtu="${1:-}"; shift ;;
        --keepalive)       shift; keepalive="${1:-}"; shift ;;
        --table)           shift; table="${1:-}"; shift ;;
        --probe-target)    shift; probe_target="${1:-}"; shift ;;
        --no-probe)        no_probe="1"; shift ;;
        --ss-port)         shift; ss_port="${1:-}"; shift ;;
        --ss-password)     shift; ss_password="${1:-}"; shift ;;
        --obfs-host)       shift; obfs_host="${1:-}"; shift ;;
        --bind)            shift; bind_ip="${1:-}"; shift ;;
        --env-file)        shift; env_file="${1:-}"; shift ;;
        --name)            shift; container="${1:-}"; shift ;;
        --state-volume)    shift; state_volume="${1:-}"; shift ;;
        --build|--rebuild) force_build="1"; shift ;;
        --help|-h)         usage ;;
        *)                 warn "unknown option: $1"; shift ;;
    esac
done

[ -n "$env_file" ] && [ ! -f "$env_file" ] && error "env file not found: $env_file"
[ -n "$conf_file" ] && [ ! -f "$conf_file" ] && error "config file not found: $conf_file"

# ---------------------------------------------------------------------------
# Ensure docker is available; install it (root) + add the user to the docker
# group only if it's missing.
# ---------------------------------------------------------------------------
if ! installed docker; then
    warn "docker not found, installing it..."
    if [ "$(id -u)" -ne 0 ]; then
        error "docker is not installed and this is not root — re-run via 'sudo im --docker' or install docker first"
    fi
    curl ${CURL_OPTS} -sL "$base_url/docker" | bash || error "docker installation failed"
    installed docker || error "docker installation failed"
    if [ -n "$target_user" ]; then
        usermod -aG docker "$target_user" || warn "failed to add $target_user to the docker group"
        info "added $target_user to the docker group"
    fi
fi

# Verify the invoking user can actually reach the docker daemon. sudo -u runs
# initgroups(), so a freshly-added docker group is already effective here.
if ! as_user docker version >/dev/null 2>&1; then
    if [ -n "$target_user" ]; then
        error "user '$target_user' cannot access the docker daemon (not in the docker group?). Add with: usermod -aG docker $target_user"
    fi
    error "cannot access the docker daemon"
fi
info "running docker as: ${target_user:-$(id -un)}"

# One config source has to be present, unless a previous run persisted one.
if [ -z "$conf_file" ] && [ -z "$private_key" ] && [ -z "$env_file" ] && [ -z "${WG_CONFIG:-}" ]; then
    if ! as_user docker volume inspect "$state_volume" >/dev/null 2>&1; then
        error "no WireGuard config: pass --conf <file>, or --private-key/--address/--peer-key/--endpoint, or --env-file"
    fi
    warn "no config passed — relying on the one persisted in volume '$state_volume'"
fi

# ---------------------------------------------------------------------------
# Fetch the build context (Dockerfile + entrypoint) and build the image.
# ---------------------------------------------------------------------------
build_dir="$(mktemp -d -t wg-ss-XXXXXXXX)"
trap 'rm -rf "$build_dir"' EXIT

info "fetching build context from $base_url/wg-ss ..."
curl ${CURL_OPTS} -fsSL "$base_url/wg-ss/Dockerfile"           -o "$build_dir/Dockerfile" \
    || error "failed to fetch Dockerfile"
curl ${CURL_OPTS} -fsSL "$base_url/wg-ss/docker-entrypoint.sh" -o "$build_dir/docker-entrypoint.sh" \
    || error "failed to fetch docker-entrypoint.sh"
# The build context must be readable by the invoking user.
[ -n "$target_user" ] && [ "$(id -u)" -eq 0 ] && chown -R "$target_user" "$build_dir"

if [ -n "$force_build" ] || ! as_user docker image inspect "$image" >/dev/null 2>&1; then
    info "building $image image..."
    as_user docker build -t "$image" "$build_dir" || error "docker build failed"
fi

# ---------------------------------------------------------------------------
# Run the container (as the invoking user).
# ---------------------------------------------------------------------------
# The launcher has to know the SS port in order to publish it, so resolve it the
# same way the container will: --ss-port wins, then SS_PORT from the env file,
# then the default. Without the env-file lookup the -e below would silently
# override an SS_PORT set in the env file (docker takes the last value), and the
# published port would not match what ss-server binds.
env_ss_port=""
if [ -z "$ss_port" ] && [ -n "$env_file" ]; then
    # docker --env-file keeps inline comments literal, so strip them here too
    env_ss_port="$(sed -n 's/^[[:space:]]*SS_PORT[[:space:]]*=//p' "$env_file" \
                    | tail -n1 | sed 's/#.*//' | tr -d '[:space:]')"
    if [ -n "$env_ss_port" ]; then
        case "$env_ss_port" in
            *[!0-9]*) error "SS_PORT in $env_file is not a number: '$env_ss_port'" ;;
        esac
        info "using SS_PORT=$env_ss_port from $env_file"
    fi
fi
port="${ss_port:-${env_ss_port:-8388}}"

if as_user docker ps -a --format '{{.Names}}' | grep -qx "$container"; then
    info "removing existing container: $container"
    as_user docker rm -f "$container" >/dev/null
fi

run_args=(
    -d
    --name "$container"
    --hostname "$container"
    --restart unless-stopped
    --cap-add NET_ADMIN
    --device /dev/net/tun
    --sysctl net.ipv4.conf.all.src_valid_mark=1
    -v "${state_volume}:/etc/wireguard"
    -p "${bind_ip}:${port}:${port}/tcp"
    -p "${bind_ip}:${port}:${port}/udp"
)

if [ -n "$conf_file" ]; then
    conf_abs="$(cd "$(dirname "$conf_file")" && pwd)/$(basename "$conf_file")"
    run_args+=(-v "${conf_abs}:/config/wg0.conf:ro")
fi

[ -n "$env_file" ] && run_args+=(--env-file "$env_file")

[ -n "$private_key" ] && run_args+=(-e "WG_PRIVATE_KEY=${private_key}")
[ -n "$address" ]     && run_args+=(-e "WG_ADDRESS=${address}")
[ -n "$peer_key" ]    && run_args+=(-e "WG_PEER_PUBLIC_KEY=${peer_key}")
[ -n "$endpoint" ]    && run_args+=(-e "WG_ENDPOINT=${endpoint}")
[ -n "$psk" ]         && run_args+=(-e "WG_PRESHARED_KEY=${psk}")
[ -n "$allowed_ips" ] && run_args+=(-e "WG_ALLOWED_IPS=${allowed_ips}")
[ -n "$dns" ]         && run_args+=(-e "WG_DNS=${dns}")
[ -n "$no_dns" ]      && run_args+=(-e "WG_USE_DNS=false")
[ -n "$mtu" ]         && run_args+=(-e "WG_MTU=${mtu}")
[ -n "$keepalive" ]   && run_args+=(-e "WG_KEEPALIVE=${keepalive}")
[ -n "$table" ]       && run_args+=(-e "WG_TABLE=${table}")
[ -n "$probe_target" ] && run_args+=(-e "WG_PROBE_TARGET=${probe_target}")
[ -n "$no_probe" ]    && run_args+=(-e "WG_PROBE=false")
run_args+=(-e "SS_PORT=${port}")
[ -n "$ss_password" ] && run_args+=(-e "SS_PASSWORD=${ss_password}")
[ -n "$obfs_host" ]   && run_args+=(-e "SS_OBFS_HOST=${obfs_host}")

info "starting $container (SS on ${bind_ip}:${port} tcp+udp)..."
as_user docker run "${run_args[@]}" "$image" >/dev/null || error "failed to start $container"

info "started. follow logs with:  docker logs -f $container"
info "the SS password (if auto-generated) is printed in those logs."
