# wg-ss container environment file. Copy to .wg-ss.env and edit.
#
#   cp .wg-ss.env.example .wg-ss.env
#   ./run --env-file .wg-ss.env          # or:  im -wgss --env-file .wg-ss.env
#
# IMPORTANT: this file is consumed by `docker --env-file`, which does NOT support
# inline comments. Everything after `=` is taken literally, so a line like
#   WG_ADDRESS=10.0.0.2/32   # my note
# sets WG_ADDRESS to "10.0.0.2/32   # my note" and breaks the config. Keep
# comments on their OWN line (a line starting with #) and put nothing after the
# value.
#
# Nothing here is baked into the image — the private key stays on the host.

# ===== WireGuard (client peer) =====

# Option A: paste a whole WireGuard config. Base64 is the practical form, since
# docker env values cannot span lines:
#   base64 -w0 wg0.conf
# A raw config also works if newlines are written as \n.
#WG_CONFIG=

# Option B (used when WG_CONFIG is empty): discrete values.
# The client's private key. REQUIRED unless WG_CONFIG is set, /config/wg0.conf
# is mounted, or a previous run persisted a config in the state volume.
WG_PRIVATE_KEY=

# This peer's address inside the tunnel. Providers hand out a /32.
WG_ADDRESS=10.0.0.2/32

# The server's public key and endpoint.
WG_PEER_PUBLIC_KEY=
WG_ENDPOINT=vpn.example.com:51820

# Optional pre-shared key (wg genpsk), for the extra symmetric layer.
#WG_PRESHARED_KEY=

# What gets routed INTO the tunnel. The default is a full tunnel: every target
# ss-server dials egresses through the peer. Narrow it to split-tunnel, e.g.
# only a private LAN:
#   WG_ALLOWED_IPS=10.0.0.0/24,192.168.1.0/24
#WG_ALLOWED_IPS=0.0.0.0/0,::/0

# Tunnel MTU. Lower it (1380, 1280) if you see stalled large transfers.
#WG_MTU=1420

# Keepalive, needed when this side sits behind NAT.
#WG_KEEPALIVE=25

# Resolver used inside the container. A DNS= line in a mounted/base64 config is
# picked up automatically; this overrides it.
#WG_DNS=10.0.0.1

# Set false to ignore tunnel DNS entirely and keep docker's resolver (DNS then
# resolves outside the tunnel).
#WG_USE_DNS=true

# Advanced: hand the routing table to wg-quick by name, or 'off' to add routes
# yourself. Leave empty for wg-quick's automatic behaviour.
#WG_TABLE=

# ===== Liveness probe =====

# A ping through the tunnel is the only way to tell "idle" from "dead":
# WireGuard only rekeys when data flows. On repeated failure the entrypoint
# bounces the interface in place; if that never helps it exits so docker's
# restart policy takes over.
# Values: true | false
#WG_PROBE=true

# Address to ping through the tunnel. Defaults to 1.1.1.1 for a full tunnel, or
# the first host of AllowedIPs otherwise. Set it explicitly if that guess is
# wrong — an unreachable target disables the probe (logged at startup).
#WG_PROBE_TARGET=10.0.0.1

# Seconds between probes, consecutive failures before a restart, and how many
# restarts to attempt before giving up and exiting.
#WG_PROBE_INTERVAL=30
#WG_PROBE_FAILURES=3
#WG_MAX_RESTARTS=5

# Handshake age (seconds) that counts as stale when no probe target is usable.
#WG_HANDSHAKE_TIMEOUT=180

# ===== Shadowsocks (external entry point) =====

# Port clients connect to.
#SS_PORT=8388

# Password. Auto-generated and printed to the container log if left empty.
#SS_PASSWORD=

# AEAD cipher. Must match the client.
#SS_METHOD=chacha20-ietf-poly1305

# Values: tcp_only | udp_only | tcp_and_udp
#SS_MODE=tcp_and_udp

# simple-obfs mode. Values: http | tls | none
#SS_OBFS=http

# Host clients should masquerade as. This is a CLIENT setting — the server
# ignores it; the entrypoint only logs it so you can copy it into the client.
#SS_OBFS_HOST=microsoft.com
